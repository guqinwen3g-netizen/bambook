generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProjectMemory {
  id          String   @id
  type        String
  layer       String
  content     String
  description String?
  timestamp   BigInt
  deletedAt   BigInt?
  source      String?  @default("ARCHITECT")
  status      String?  @default("STABLE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([layer])
  @@index([type])
}

model BusinessProfile {
  id        String  @id
  kind      String
  name      String
  payload   Json
  assets    Json?
  isActive  Boolean @default(true)
  updatedAt BigInt
  deletedAt BigInt?

  @@index([kind])
  @@index([isActive])
}

model KnowledgeItem {
  id        String  @id
  title     String
  content   String
  category  String
  sourceUrl String?
  updatedAt BigInt
  deletedAt BigInt?

  @@index([category])
}

model Order {
  id          String  @id
  customer    String
  product     String
  type        String
  quantity    Int
  status      String
  dueDate     String
  quoteAmount Decimal @db.Decimal(18, 4)
  updatedAt   BigInt?
  deletedAt   BigInt?

  // --- Imported PO header (nullable for legacy rows) ---
  poNumber       String?  @unique
  customerCode   String?
  season         String?
  poDate         String?
  contactPerson  String?
  contactPhone   String?
  currency       String?
  deliveryTerms  String?
  paymentTerms   String?
  shipToName     String?
  shipToAddress1 String?
  shipToAddress2 String?
  shipToCountry  String?
  shipToPhone    String?
  deliverTo      String?
  totalNet       Decimal? @db.Decimal(18, 4)
  totalActual    Decimal? @db.Decimal(18, 4)
  source         String? // e.g. "pdf-import", "manual"
  importedAt     BigInt?

  // ============ Phase 2: per-field provenance + currency split ============
  /// JSONB map: { [fieldKey]: 'pdf' | 'manual' | 'imported-then-edited' }.
  /// PDF re-import uses this to skip fields the user has manually edited.
  fieldSources     Json?
  purchaseCurrency String? // default 'CNY' for purchase-side amounts
  salesCurrency    String? // default 'USD' for sales-side amounts

  // ============ Phase 2: Role snapshots + Relation FKs ============
  // FKs are *snapshot* references — we do NOT enforce a foreign-key constraint
  // because Relation rows can be archived independently of orders.
  customerAddress    String?
  customerRelationId String?

  // Mill / 面料工厂 / supplier (应付侧)
  millName       String?
  millAddress    String?
  millContact    String?
  millPhone      String?
  millRelationId String?

  // Consignee / 服装厂收货方 (物流目的地)
  consigneeName       String?
  consigneeAddress    String?
  consigneeContact    String?
  consigneeRelationId String?

  // Bill-to / 结款方 (服装厂或其代理)
  billToName       String?
  billToAddress    String?
  billToContact    String?
  billToIsAgent    Boolean?
  billToRelationId String?

  // ============ Internal Team ============
  salesPerson            String?
  salesPersonRelationId  String?
  merchandiser           String?
  merchandiserRelationId String?
  supervisor             String?
  supervisorRelationId   String?

  // ============ Phase 2: Contracts ============
  salesContractNumber String? // 早期销售合同号 (出给客户)
  finalContractNumber String? // 最终销售合同号 (出给 Bill-to)

  // ============ Phase 2: Detail-card rich fields (lifted from localStorage) ============
  // Production / OTS basic
  productionBatch  String?
  productColorCode String?
  clientCode       String? // ZROH 客户编码 (sticky overlay on top of firstLine.materialCode)
  referenceBatch   String?
  productionDate   String? // 生产交期
  clientDate       String? // 出厂交期 (Exmill)

  // Fabric specs (sticky overlay on top of firstLine; PDF supplies fallback)
  fabricCode    String?
  fabricContent String?
  width         String?
  gsm           String?

  // A/S contact (跟单/售后)
  asPerson String?

  // Sales / collection
  salesPrice          Decimal? @db.Decimal(18, 4)
  contractAmount      Decimal? @db.Decimal(18, 4)
  paymentInstrument   String? // T/T, L/C, O/A, D/P, D/A
  expectedPaymentDate String?
  actualPaymentDate   String?
  actualPaymentAmount Decimal? @db.Decimal(18, 4)

  // Shipment & invoice (我方开给 Bill-to)
  invoiceNumber    String?
  invoiceDate      String?
  shipmentDate     String?
  shipmentMethod   String?
  shipmentQuantity Float?
  shipmentAmount   Decimal? @db.Decimal(18, 4)

  // Shipment sample (大货船样)
  sampleSentDate         String?
  sampleConfirmedDate    String?
  sampleTrackingNumber   String?
  shipmentSampleComments String?

  // Fabric sample (匹头样)
  fabricSampleSentDate       String?
  fabricSampleConfirmedDate  String?
  fabricSampleTrackingNumber String?
  paidSampleQuantity         Float?

  // Purchase / supplier invoice (我方付给 Mill)
  purchasePrice         Decimal? @db.Decimal(18, 4)
  purchasePaymentDate   String?
  supplierInvoiceNumber String?
  supplierInvoiceDate   String?
  supplierInvoiceAmount Decimal? @db.Decimal(18, 4)

  // Misc
  specialInstructions   String?
  ocDays                Int?

  // ============ Production pipeline deadlines (业务十条规则) ============
  productionPlanDeadline String? // 下单后7天内需出生产计划（createdAt + 7d），超时触发预警
  delayNoticeDeadline   String? // 交货期前15天需发延期通知（dueDate - 15d），超时升级

  lines             OrderLine[]
  statusTransitions OrderStatusTransition[]

  @@index([status])
  @@index([customerCode])
  @@index([millName])
  @@index([consigneeName])
  @@index([billToName])
}

model OrderLine {
  id                  String   @id
  orderId             String
  lineNumber          Int
  itemNo              String?
  materialCode        String?
  millQuality         String?
  description         String?
  width               String?
  exMillDate          String?
  deliveryDate        String?
  quantity            Decimal  @db.Decimal(18, 4)
  unit                String?
  unitPrice           Decimal? @db.Decimal(18, 4)
  netValue            Decimal? @db.Decimal(18, 4)
  via                 String?
  cloth               String?
  weight              String?
  category            String?
  notes               String?
  status              String?  @default("Pending")
  productionBatch     String?
  shippingDate        String?
  shippingMethod      String?
  invoiceNumber       String?
  invoiceDate         String?
  shipmentQuantity    Float?
  shipmentAmount      Decimal? @db.Decimal(18, 4)
  actualPaymentDate   String?
  actualPaymentAmount Decimal? @db.Decimal(18, 4)
  specialInstructions String?
  fieldSources        Json?

  // Garment-specific extension fields
  sizeBreakdown   Json? // { S: 100, M: 200, L: 200, XL: 100, XXL: 50 }
  productionSteps Json? // [ { step: "cutting", status: "done", date: "..." }, ... ]
  styleNo         String? // 款式号 → links to ProductAsset/GarmentProfile
  colorName       String? // 色号名称
  bomItems        Json? // [ { type: "fabric", name: "...", qty: 1.5, unit: "meter" }, ... ]

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, itemNo])
  @@index([orderId])
  @@index([status])
}

model OrderStatusTransition {
  id         String  @id
  orderId    String
  fromStatus String
  toStatus   String
  note       String?
  operator   String?
  lineId     String?
  createdAt  BigInt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([toStatus])
  @@index([createdAt])
}

model Relation {
  id              String   @id
  name            String
  category        String
  type            String
  isOrganization  Boolean
  parentId        String?
  reportsToId     String?
  role            String?
  department      String?
  tags            String[]
  contactInfo     String
  rating          Float    @default(0)
  lastInteraction BigInt
  preferences     String?
  deletedAt       BigInt?

  // Organization fields mirrored by the Relations UI.
  chineseName         String?
  englishName         String?
  creditLevel         String?
  summary             String?
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  backupContacts      Json?
  shipToAddresses     Json?
  financialNotes      String?
  website             String?
  paymentTerms        String?
  paymentPreference   String?
  currency            String?
  taxId               String?
  creditLimit         Decimal? @db.Decimal(18, 4)
  officialAddress     String?
  factoryAddresses    String[]
  warehouseAddress    String?
  billingAddress      String?
  shippingAddress     String?
  coordinatesLat      Float?
  coordinatesLng      Float?

  // Contact fields mirrored by the Relations UI.
  email         String?
  phone         String?
  mobile        String?
  wechat        String?
  whatsapp      String?
  otherContacts Json?
  birthday      String?
  language      String?
  timezone      String?
  personalNote  String?

  @@index([category])
  @@index([isOrganization])
  @@index([parentId])
}

model ProductAsset {
  id            String  @id
  sku           String  @unique
  name          String
  mainCategory  String
  subCategoryId String
  season        String
  techPackUrl   String?
  imageUrl      String?
  cost          Decimal @db.Decimal(18, 4)
  status        String
  updatedAt     BigInt
  deletedAt     BigInt?

  fabricProfile        FabricProfile?
  garmentProfile       GarmentProfile?
  trimmingProfile      TrimmingProfile?
  classificationLinks  ProductClassificationLink[]
  fabricCustomerCodes  FabricCustomerCode[]
  fabricPrices         FabricPriceHistory[]
  fabricCertifications FabricCertification[]
  compositionLines     FabricCompositionLine[]
  images               ProductImage[]

  @@index([sku])
  @@index([season])
}

model ProductSubCategory {
  id           String  @id
  mainCategory String
  name         String
  description  String?
  updatedAt    BigInt
  deletedAt    BigInt?
}

model FabricProfile {
  id                 String  @id
  productAssetId     String  @unique
  articleNo          String?
  millOrganizationId String?
  millQuality        String?
  millColorCode      String?
  colorDescription   String?
  construction       String?
  yarnCount          String?
  pattern            String?
  weightValue        Float?
  weightUnit         String?
  widthValue         Float?
  widthUnit          String?
  widthText          String?
  productionLeadDays Int?
  referenceBatch     String?
  stockStatus        String?
  stockQuantity      Float?
  stockUnit          String?
  moqValue           Float?
  factoryMoqValue    Float?
  sampleMoqValue     Float?
  riskNote           String?
  specialNote        String?
  updatedAt          BigInt
  deletedAt          BigInt?

  productAsset ProductAsset @relation(fields: [productAssetId], references: [id], onDelete: Cascade)

  @@index([millOrganizationId])
  @@index([millQuality])
  @@index([articleNo])
}

model GarmentProfile {
  id                  String  @id
  productAssetId      String  @unique
  styleNo             String?
  productName         String?
  garmentCategory     String?
  collection          String?
  customer            String?
  brand               String?
  project             String?
  gender              String?
  ageGroup            String?
  tags                String?
  silhouette          String?
  fit                 String?
  collarType          String?
  sleeveType          String?
  closureType         String?
  pocketDetails       String?
  hemDetails          String?
  waistbandDetails    String?
  liningStructure     String?
  interlining         String?
  shoulderPad         String?
  stitchDetails       String?
  constructionNote    String?
  mainFabric          String?
  contrastFabric      String?
  liningFabric        String?
  ribFabric           String?
  pocketingFabric     String?
  button              String?
  zipper              String?
  snapsEyelets        String?
  thread              String?
  labelTrims          String?
  packaging           String?
  materialUsage       String?
  substituteMaterials String?
  sizeRange           String?
  baseSize            String?
  measurementPoints   String?
  sizeSpec            String?
  tolerance           String?
  gradingRule         String?
  shrinkageAllowance  String?
  garmentWeight       String?
  colorways           String?
  customerColorCodes  String?
  fabricColorCodes    String?
  garmentSku          String?
  barcode             String?
  availableSizes      String?
  colorImageNotes     String?
  moq                 String?
  sampleVersion       String?
  patternMaker        String?
  merchandiser        String?
  owner               String?
  revisionHistory     String?
  fittingComments     String?
  customerComments    String?
  confirmedDate       String?
  techPackVersion     String?
  factory             String?
  orderQuantity       String?
  deliveryDate        String?
  targetCost          String?
  fobPrice            String?
  exwPrice            String?
  retailPrice         String?
  inspectionStandard  String?
  commonDefects       String?
  washFinishing       String?
  careLabel           String?
  complianceTests     String?
  packingMethod       String?
