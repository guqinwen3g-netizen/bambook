model FabricCertification {
  id             String  @id
  productAssetId String
  certification  String
  certificateNo  String?
  validUntil     String?
  note           String?
  updatedAt      BigInt
  deletedAt      BigInt?

  productAsset ProductAsset @relation(fields: [productAssetId], references: [id], onDelete: Cascade)

  @@index([productAssetId])
  @@index([certification])
}

model PdmlRawFabric {
  id               String  @id
  gsid             String
  sourceId         String
  rawData          Json
  sourceHash       String
  articleNo        String?
  factoryArticleNo String?
  colorCode        String?
  factoryColorCode String?
  supplierName     String?
  productLine      String?
  registeredDate   String?
  imageUrl         String?
  sourceStatus     String?
  firstSeenAt      BigInt
  lastSeenAt       BigInt
  syncedAt         BigInt
  deletedAt        BigInt?

  @@unique([gsid, sourceId])
  @@index([sourceId])
  @@index([gsid])
  @@index([articleNo])
  @@index([factoryArticleNo])
  @@index([supplierName])
  @@index([productLine])
  @@index([registeredDate])
  @@index([sourceStatus])
}

model Insight {
  id         String  @id
  fact       String
  importance String
  timestamp  BigInt
  isPinned   Boolean @default(false)
  deletedAt  BigInt?
}

model ProductImage {
  id             String  @id
  productAssetId String
  filePath       String
  fileName       String
  mimeType       String
  fileSize       Int
  sortOrder      Int     @default(0)
  isPrimary      Boolean @default(false)
  uploadedAt     BigInt
  deletedAt      BigInt?

  productAsset ProductAsset @relation(fields: [productAssetId], references: [id], onDelete: Cascade)

  @@index([productAssetId])
  @@index([isPrimary])
}

model SystemAsset {
  id        String  @id
  kind      String
  title     String
  group     String
  filePath  String?
  fileName  String?
  mimeType  String?
  fileSize  Int?
  sortOrder Int     @default(0)
  hidden    Boolean @default(false)
  metadata  Json?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([kind])
  @@index([hidden])
  @@index([sortOrder])
}

// ------------------------------------------------------------------
// Enterprise Agent OS
// ------------------------------------------------------------------

model UserAccount {
  id            String    @id
  displayName   String
  email         String?   @unique
  avatarUrl     String?
  passwordHash  String    @default("")
  status        String    @default("active")
  primaryDeptId String?
  metadata      Json?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     BigInt?

  primaryDepartment       Department?              @relation(fields: [primaryDeptId], references: [id])
  roles                   UserRole[]
  sessions                AgentSession[]
  messages                AgentMessage[]
  memories                AgentMemory[]
  approvals               ApprovalRequest[]        @relation("ApprovalRequester")
  approvalsReviewed       ApprovalRequest[]        @relation("ApprovalReviewer")
  toolRuns                AgentToolRun[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  workflowInitiated       WorkflowInstance[]       @relation("WorkflowInitiator")
  workflowDecided         WorkflowStep[]           @relation("WorkflowDecider")
  employeeProfile         EmployeeProfile?

  @@index([status])
  @@index([primaryDeptId])
}

model Department {
  id        String   @id
  name      String
  parentId  String?
  status    String   @default("active")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Department?    @relation("DepartmentTree", fields: [parentId], references: [id])
  children     Department[]   @relation("DepartmentTree")
  users        UserAccount[]
  roles        UserRole[]
  sessions     AgentSession[]
  memories     AgentMemory[]
  documentAcls KnowledgeAcl[]
  jobPositions JobPosition[]
  teams        Team[]

  @@index([parentId])
  @@index([status])
}

model Role {
  id          String   @id
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        UserRole[]
  permissions  RolePermission[]
  toolPerms    AgentToolPermission[]
  policies     AgentPolicy[]
  documentAcls KnowledgeAcl[]

  @@index([isSystem])
}

model UserRole {
  id           String   @id
  userId       String
  roleId       String
  departmentId String?
  createdAt    DateTime @default(now())

  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([userId, roleId, departmentId])
  @@index([roleId])
  @@index([departmentId])
}

model Permission {
  id          String   @id
  scope       String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String @id
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model AgentPolicy {
  id         String   @id
  name       String
  roleId     String?
  scope      String
  action     String
  effect     String
  risk       String   @default("low")
  conditions Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role Role? @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([scope, action])
}

// ─────────────────────────────────────────────
// HR Management Models
// ─────────────────────────────────────────────

/// 岗位/职位（如：跟单员、面料采购员、生产主管）
model JobPosition {
  id           String   @id
  title        String
  departmentId String?
  description  String?
  headcount    Int      @default(1)
  status       String   @default("active")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    BigInt?

  department Department? @relation(fields: [departmentId], references: [id])
  employees  EmployeeProfile[]

  @@index([departmentId])
  @@index([status])
}

/// 团队（可跨部门，按项目/职能临时组建）
model Team {
  id           String   @id
  name         String
  description  String?
  leaderId     String?
  departmentId String?
  status       String   @default("active")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    BigInt?

  department Department?  @relation(fields: [departmentId], references: [id])
  members    TeamMember[]
  projects   Project[]

  @@index([departmentId])
  @@index([status])
}

/// 团队成员关联表
model TeamMember {
  id       String    @id
  teamId   String
  userId   String
  role     String    @default("member")
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

/// 项目（可关联订单/开发案，也可独立）
model Project {
  id          String   @id
  name        String
  code        String?
  description String?
  teamId      String?
  status      String   @default("planning")
  priority    String   @default("normal")
  startDate   String?
  endDate     String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   BigInt?

  team        Team?            @relation(fields: [teamId], references: [id])
  members     ProjectMember[]
  assignments WorkAssignment[]

  @@index([teamId])
  @@index([status])
}

/// 项目成员关联表
model ProjectMember {
  id        String   @id
  projectId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// 工作分配/任务（将人分配到具体工作项）
model WorkAssignment {
  id          String    @id
  title       String
  description String?
  projectId   String?
  userId      String
  assignerId  String?
  status      String    @default("assigned")
  priority    String    @default("normal")
  dueDate     String?
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   BigInt?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

// ─────────────────────────────────────────────
// C3 HR 深化 Models（员工档案/生命周期/考勤/薪资/绩效/培训）
// ─────────────────────────────────────────────

/// C3a 员工档案扩展（与 UserAccount 1:1，承载 HR 业务字段，UserAccount 保持认证纯净）
model EmployeeProfile {
  id               String   @id
  userId           String   @unique
  employeeNo       String   @unique
  positionId       String?
  hireDate         String // YYYY-MM-DD
  regularDate      String? // 转正日期（试用期待转正提醒依据）
  contractType     String? // FixedTerm / OpenEnded / PartTime / Intern
  contractEnd      String? // 合同到期日（到期提醒依据）
  employmentStatus String   @default("Probation") // Probation/Regular/Suspended/Resigned/Terminated
  phone            String?
  emergencyContact String?
  workLocation     String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        BigInt?

  user     UserAccount  @relation(fields: [userId], references: [id])
  position JobPosition? @relation(fields: [positionId], references: [id])

  @@index([employmentStatus])
  @@index([positionId])
}

/// C3a 员工生命周期事件（入/转/调/升/停/复/离，历史流水 — 故意用松散 id 引用，部门/岗位改名删除不影响历史）
model EmploymentEvent {
  id             String   @id
  userId         String
  type           String // Onboard/Regularize/Transfer/Promote/Suspend/Resume/Resign/Terminate
  effectiveDate  String // YYYY-MM-DD
  fromDeptId     String?
  toDeptId       String?
  fromPositionId String?
  toPositionId   String?
  reason         String?
  operatorId     String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([effectiveDate])
}

/// C3b 考勤打卡记录（每人每日一条）
model AttendanceRecord {
  id        String   @id
  userId    String
  date      String // YYYY-MM-DD
  checkIn   String? // HH:MM
  checkOut  String? // HH:MM
  status    String   @default("Normal") // Normal/Late/EarlyLeave/LateAndEarly/Absent/Leave/Holiday/Overtime
  workHours Float?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([status])
}

/// C3b 请假申请（状态机与退税审核同口径：Pending→Approved/Rejected，可 Cancelled）
model LeaveRequest {
  id           String    @id
  userId       String
  type         String // Annual/Sick/Personal/CompTime/Maternity/Other
  startDate    String
  endDate      String
  days         Float
  reason       String?
  status       String    @default("Pending") // Pending/Approved/Rejected/Cancelled
  approverId   String?
  approvedAt   DateTime?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    BigInt?

  @@index([userId])
  @@index([status])
}

/// C3c 薪资结构（变更留痕：effectiveFrom/To 形成生效区间，当前生效 effectiveTo=null）
model SalaryStructure {
  id                String   @id
  userId            String
  baseSalary        Float
  positionAllowance Float    @default(0)
  currency          String   @default("CNY")
  effectiveFrom     String // YYYY-MM-DD
  effectiveTo       String?
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

/// C3c 月度工资单批次（Draft→Confirmed→Paid）
model PayrollRun {
  id          String    @id
  period      String // YYYY-MM
  status      String    @default("Draft") // Draft/Confirmed/Paid
  totalNet    Float     @default(0)
  headcount   Int       @default(0)
  note        String?
  confirmedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items PayrollItem[]

  @@unique([period])
}

/// C3c 工资单明细行（commission 可引用 P2 佣金结算额，手工录入）
model PayrollItem {
  id          String   @id
  runId       String
  userId      String
  base        Float    @default(0)
  allowance   Float    @default(0)
  overtimePay Float    @default(0)
  commission  Float    @default(0)
  bonus       Float    @default(0)
  deduction   Float    @default(0)
  net         Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  run PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@index([userId])
}

/// C3d 绩效考核周期
model PerformanceCycle {
  id        String   @id
  name      String
  period    String // 如 2026-H1 / 2026-Q3
  status    String   @default("Open") // Open/Closed
  startDate String?
  endDate   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews PerformanceReview[]

  @@unique([period])
}

/// C3d 绩效评定（自评→主管评→终评确认；kpi Json 保持指标弹性）
model PerformanceReview {
  id           String   @id
  cycleId      String
  userId       String
  selfScore    Float?
  managerScore Float?
  finalScore   Float?
  grade        String? // A/B/C/D
  kpi          Json?
  comment      String?
  status       String   @default("Draft") // Draft/Submitted/Confirmed
  reviewerId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cycle PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, userId])
  @@index([userId])
}

/// C3e 培训课程
model TrainingCourse {
  id          String   @id
  title       String
  type        String   @default("Internal") // Internal/External
  instructor  String?
  startDate   String?
  endDate     String?
  capacity    Int?
  status      String   @default("Planned") // Planned/Ongoing/Completed/Cancelled
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   BigInt?

  enrollments TrainingEnrollment[]

  @@index([status])
}

/// C3e 培训报名/成绩记录
model TrainingEnrollment {
  id          String   @id
  courseId    String
  userId      String
  status      String   @default("Enrolled") // Enrolled/Completed/Absent/Cancelled
  score       Float?
  certificate String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model AgentSession {
  id           String   @id
  userId       String
  departmentId String?
  title        String?
  status       String   @default("active")
  memoryScopes String[]
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    BigInt?

  user       UserAccount    @relation(fields: [userId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  messages   AgentMessage[]

  @@index([userId])
  @@index([departmentId])
  @@index([status])
}

model AgentMessage {
  id        String   @id
  sessionId String
  userId    String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  deletedAt BigInt?

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    UserAccount  @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}

model AgentMemory {
  id              String   @id
  userId          String?
  departmentId    String?
  scope           String
  memoryType      String
  content         String
  summary         String?
  confidence      Float    @default(0.7)
  sourceType      String?
  sourceId        String?
  relatedEntity   String?
  relatedEntityId String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       BigInt?

  user       UserAccount? @relation(fields: [userId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])

  @@index([scope])
  @@index([memoryType])
  @@index([userId])
  @@index([departmentId])
  @@index([relatedEntity, relatedEntityId])
}

model KnowledgeDocument {
  id         String   @id
  title      String
  sourceType String
  sourceUri  String?
  mimeType   String?
  checksum   String?
  version    Int      @default(1)
  status     String   @default("active")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  BigInt?

  chunks    KnowledgeChunk[]
  relations KnowledgeRelation[]
  acls      KnowledgeAcl[]

  @@index([sourceType])
  @@index([status])
  @@index([checksum])
}

model KnowledgeChunk {
  id          String   @id
  documentId  String
  chunkIndex  Int
  content     String
  summary     String?
  tags        String[]
  sourceRange Json?
  embedding   Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   BigInt?

  document  KnowledgeDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  relations KnowledgeRelation[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model KnowledgeRelation {
  id           String   @id
  documentId   String?
  chunkId      String?
  relationType String
  targetType   String
  targetId     String
  confidence   Float    @default(0.7)
  createdAt    DateTime @default(now())

  document KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk    KnowledgeChunk?    @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkId])
  @@index([targetType, targetId])
  @@index([relationType])
}

model EntityReference {
  id         String  @id
  ownerType  String
  ownerId    String
  fieldKey   String
  targetType String
  targetId   String
  targetPath String?
  snapshot   Json?
  confidence Float?
  source     String?
  status     String  @default("active")
  createdAt  BigInt
  updatedAt  BigInt
  deletedAt  BigInt?

  @@unique([ownerType, ownerId, fieldKey, targetType, targetId, targetPath])
  @@index([ownerType, ownerId])
  @@index([fieldKey])
  @@index([targetType, targetId])
  @@index([status])
  @@index([source])
}

model EntityAlias {
  id         String  @id
  targetType String
  targetId   String
  targetPath String?
  alias      String
  normalized String
  source     String?
  confidence Float?
  createdAt  BigInt
  updatedAt  BigInt
  deletedAt  BigInt?

  @@index([targetType, targetId])
  @@index([targetPath])
  @@index([normalized])
  @@index([source])
}

model EntityLink {
  id         String  @id
  fromType   String
  fromId     String
  fromPath   String?
  toType     String
  toId       String
  toPath     String?
  linkKind   String
  confidence Float?
  metadata   Json?
  source     String?
  status     String  @default("active")
  createdAt  BigInt
  updatedAt  BigInt
  deletedAt  BigInt?

  @@index([fromType, fromId])
  @@index([toType, toId])
  @@index([linkKind])
  @@index([status])
  @@index([source])
}

model KnowledgeAcl {
  id           String  @id
  documentId   String
  roleId       String?
  departmentId String?
  scope        String
  access       String  @default("read")

  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role       Role?             @relation(fields: [roleId], references: [id])
  department Department?       @relation(fields: [departmentId], references: [id])

  @@index([documentId])
  @@index([roleId])
  @@index([departmentId])
  @@index([scope])
}

model AgentTool {
  id          String   @id
  name        String
  description String?
  scope       String
  risk        String   @default("low")
  inputSchema Json
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AgentToolPermission[]
  runs        AgentToolRun[]

  @@index([scope])
  @@index([risk])
  @@index([status])
}

model AgentToolPermission {
  id       String @id
  toolId   String
  roleId   String
  access   String @default("execute")
  riskMode String @default("direct")

  tool AgentTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  role Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([toolId, roleId])
  @@index([roleId])
}

model AgentToolRun {
  id               String    @id
  toolId           String
  userId           String?
  actorId          String?
  actorDisplayName String?
  actorRoles       Json?
  sessionId        String?
  requestSource    String?
  approvalId       String?
  status           String
  input            Json
  output           Json?
  error            String?
  risk             String    @default("low")
  idempotencyKey   String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  tool AgentTool    @relation(fields: [toolId], references: [id])
  user UserAccount? @relation(fields: [userId], references: [id])

  @@index([toolId])
  @@index([userId])
  @@index([actorId])
  @@index([sessionId])
  @@index([requestSource])
  @@index([approvalId])
  @@index([status])
  @@index([idempotencyKey])
}

/// Durable receipt for an approved Agent commit. A unique key makes retry/replay safe.
model AgentCommitReceipt {
  id             String    @id
  idempotencyKey String    @unique
  toolId         String
  approvalId     String
  status         String
  result         Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([toolId])
  @@index([approvalId])
  @@index([status])
}

model AgentJob {
  id          String    @id
  jobType     String
  status      String    @default("queued")
  priority    Int       @default(5)
  payload     Json
  result      Json?
  error       String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([jobType])
  @@index([status])
  @@index([priority])
  @@index([scheduledAt])
}

model AgentSuggestion {
  id             String    @id
  suggestionType String
  status         String    @default("pending")
  scope          String
  content        Json
  sourceType     String?
  sourceId       String?
  confidence     Float     @default(0.7)
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?
  decidedBy      String?

  @@index([suggestionType])
  @@index([status])
  @@index([scope])
}

model ApprovalRequest {
  id           String    @id
  requesterId  String
  reviewerId   String?
  actionType   String
  targetType   String
  targetId     String?
  status       String    @default("pending")
  risk         String    @default("high")
  payload      Json
  decisionNote String?
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?

  requester UserAccount  @relation("ApprovalRequester", fields: [requesterId], references: [id])
  reviewer  UserAccount? @relation("ApprovalReviewer", fields: [reviewerId], references: [id])

  @@index([requesterId])
  @@index([reviewerId])
  @@index([status])
  @@index([actionType])
}

model DevelopmentCase {
  id       String @id
  code     String @unique
  name     String
  type     String // fabric | garment | pp | trim
  stage    String // developing | shipping | feedback | revision | approved | cancelled
  priority String @default("normal") // urgent | high | normal | low

  // Owner / responsible person
  owner String?

  // Linked entities (soft references, no FK constraint)
  customerRelationId String?
  customerName       String?
  supplierRelationId String?
  supplierName       String?
  productAssetId     String?
  productName        String?

  // Process tracking
  currentRound  Int     @default(1)
  nextAction    String?
  targetDate    String?
  completedDate String?

  // Sample category + review (业务规定: 5A 样衣需生产部评审)
  sampleCategory String? @default("normal") // normal(普通) | 5a(5A重点)
  reviewStatus   String? // null(无需评审) | pending(待评审) | passed(通过) | failed(不通过)
  reviewerId     String?
  reviewDate     String?
  reviewNote     String?

  // Sample details
  sampleType           String? // lab-dip | handloom | yardage | fit-sample | pp-sample | size-set
  sampleQuantity       Float?
  sampleUnit           String? @default("meter")
  sampleSentDate       String?
  sampleTrackingNumber String?
  sampleCourier        String?
  sampleFeedback       String?
  sampleFeedbackDate   String?

  // Conversion to bulk order
  linkedOrderId String?
  linkedOrderPo String?
  convertedAt   BigInt?

  // Additional info
  notes       String?
  tags        String[]
  attachments Json?

  // Timestamps & soft delete
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type])
  @@index([stage])
  @@index([customerRelationId])
  @@index([supplierRelationId])
  @@index([productAssetId])
  @@index([owner])
  @@index([targetDate])
  @@index([code])
}

// ════════════════════════════════════════════════════════════════════
// Phase B4 — 三级样衣节点（确认样 → 产前样 → 大货样）
// 每个 DevelopmentCase 最多 3 个节点（每级一行），状态机：
//   pending(待打样) → making(制作中) → sent(已寄出) → approved(客户批准)
//                                                ↘ revising(需修改) → making（round+1）
// 业务规则：产前样批准是开裁前置条件；大货样（TOP）从大货首件抽取留档。
// ════════════════════════════════════════════════════════════════════
model SampleNode {
  id                String  @id // 格式：SN__${caseId}__${level}
  developmentCaseId String
  level             String // confirmation(确认样) | pp(产前样) | top(大货样)
  round             Int     @default(1) // 修改轮次（revising → making 时 +1）
  status            String  @default("pending") // pending | making | sent | approved | revising

  // 寄样信息
  sentDate       String? // YYYY-MM-DD
  courier        String?
  trackingNumber String?

  // 客户反馈 / 批准
  feedback     String?
  feedbackDate String? // YYYY-MM-DD
  approvedAt   BigInt?
  approvedBy   String?

  notes String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@unique([developmentCaseId, level])
  @@index([developmentCaseId])
  @@index([status])
}

// ════════════════════════════════════════════════════════════════════
// Finance Module — 财务发票管理 + 收/付款凭证核销
// Added: 2026-06-15
// Contract: docs/MODULE_CONTRACT.md (linkKind: billTo / aboutOrder / settlesInvoice)
//
// 设计取舍：
//  - 金额字段已迁移至 Decimal @db.Decimal(18,4)（Phase 3 完成）；
//    全库 Float→Decimal 迁移已完成（Phase 3）。
//    待统一 PR 迁移，不在本模块单独破例。
//  - 业务日期（issueDate/dueDate/paymentDate）用 String YYYY-MM-DD —— 与 Order.dueDate / DevelopmentCase.targetDate 一致。
//  - 时间戳（createdAt/updatedAt/deletedAt）用 BigInt epoch ms —— 与 Order/DevelopmentCase 一致。
//  - exchangeRate 已迁移至 Decimal @db.Decimal(18,4)；外贸 USD→CNY 汇率存"开票/收款当日"快照。
//  - PaymentVoucher.appliedAmount 表达"本笔凭证核销发票多少钱"，支持部分销账；
//    1:N 销账数据模型已通过 InvoiceAllocation 中间表提供地基（task_mqxwgafj），为后续 payment.receive_and_reconcile flow 做准备。
//  - Relation 关联用 *Snapshot* FK 风格（不加 @relation），与 Order 的 customerRelationId
//    一致——避免 Relation 归档时级联删除。
// ════════════════════════════════════════════════════════════════════

model Invoice {
  id            String @id // 格式：INV__${shortId}
  invoiceNumber String @unique // 业务发票号（如 INV-20260615-001）

  // ─── 业务字段 ───
  type           String // Receivable(应收-客户账单) | Payable(应付-工厂账单)
  status         String // Draft(草稿) | Issued(已开票) | PartiallyPaid(部分销账) | Paid(已结清) | Cancelled(已作废)
  amount         Decimal @db.Decimal(18, 4) // 发票金额（含税）
  currency       String // USD | CNY | EUR | HKD ...
  issueDate      String // 开票日期 YYYY-MM-DD
  dueDate        String? // 应收/应付到期日 YYYY-MM-DD（部分场景可空）
  settlementDate String? // 实际结算日期 YYYY-MM-DD（全额收/付款完成日，由 allocation 自动写入）

  // ─── 汇率快照（外贸场景必填，本币发票可空） ───
  exchangeRate Decimal? @db.Decimal(18, 4) // 开票当日 currency → baseCurrency 汇率
  baseCurrency String   @default("CNY") // 本位币

  // ─── 关联（snapshot FK） ───
  orderId            String? // 关联订单（aboutOrder linkKind）
  customerRelationId String? // 结算单位 / 开票对象（billTo linkKind）
  customerName       String? // 冗余快照：避免 Relation 改名后历史发票显示错乱

  // ─── 备注 / 附件 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type])
  @@index([status])
  @@index([orderId])
  @@index([customerRelationId])
  @@index([invoiceNumber])
  @@index([issueDate])
  @@index([dueDate])
}

model PaymentVoucher {
  id            String @id // 格式：PAY__${shortId}
  voucherNumber String @unique // 业务凭证号（如 PAY-20260615-001）

  // ─── 业务字段 ───
  type          String // Receipt(收款) | Disbursement(付款)
  amount        Decimal @db.Decimal(18, 4) // 凭证金额（实际入/出账金额，已扣手续费前）
  currency      String // USD | CNY | EUR | HKD ...
  paymentDate   String // 实际收/付款日 YYYY-MM-DD
  paymentMethod String // TT | LC | OA | DP | DA | Cash | Other
  status        String  @default("unreconciled") // unreconciled(未核销) | partially_reconciled(部分核销) | reconciled(已核销)
  bankFee       Decimal @default(0) @db.Decimal(18, 4) // 银行手续费（与 amount 同币种）

  // ─── 汇率快照 ───
  exchangeRate Decimal? @db.Decimal(18, 4) // 实际收/付款日 currency → baseCurrency 汇率
  baseCurrency String   @default("CNY")

  // ─── 核销信息 ───
  invoiceId     String? // 核销的发票（settlesInvoice linkKind）；为空表示"未核销/暂挂账"
  appliedAmount Decimal? @db.Decimal(18, 4) // 本笔凭证实际核销发票多少钱（可能 < amount，余款挂账）

  // ─── 关联（snapshot FK） ───
  orderId            String? // 冗余：直接关联订单（aboutOrder linkKind），便于按订单聚合资金流
  customerRelationId String? // 交易对象（billTo linkKind）
  customerName       String? // 冗余快照

  // ─── 备注 / 附件 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type])
  @@index([status])
  @@index([invoiceId])
  @@index([orderId])
  @@index([customerRelationId])
  @@index([voucherNumber])
  @@index([paymentDate])
}

// ════════════════════════════════════════════════════════════════════
// InvoiceAllocation — 发票核销明细（1:N 销账中间表）
// ════════════════════════════════════════════════════════════════════
// 支持一笔 PaymentVoucher 核销多张 Invoice，或一张 Invoice 被多笔 Voucher 核销。
// 替代 PaymentVoucher.appliedAmount 的单 1:1 表达（后者保留作为"主核销"快照，向后兼容）。
// 语义：硬删除（无 deletedAt）——核销调整时先 delete 旧明细再 insert 新明细，避免软删+unique 冲突。
// ════════════════════════════════════════════════════════════════════
model InvoiceAllocation {
  id            String  @id // 格式：ALLOC__${shortId}
  invoiceId     String // 核销的发票
  voucherId     String // 核销的凭证
  appliedAmount Decimal @db.Decimal(18, 4) // 本笔核销金额
  appliedDate   String // 核销日期 YYYY-MM-DD
  createdAt     BigInt
  updatedAt     BigInt

  @@unique([invoiceId, voucherId]) // 一对 invoice-voucher 只能有一条明细（硬删除，调整=delete+insert）
  @@index([invoiceId])
  @@index([voucherId])
}

// ════════════════════════════════════════════════════════════════════
// FxSettlement — 结汇水单（F2 外汇核销闭环核心）
// ════════════════════════════════════════════════════════════════════
// 业务语义：收款凭证（PaymentVoucher type=Receipt，外币）→ 银行结汇 → 人民币入账。
//   - 一笔外币收款可分次结汇（1 voucher : N settlements），核销余额 = voucher.amount - Σsettlements.foreignAmount
//   - cnyAmount 由服务端按 foreignAmount × fxRate 计算（round4），不接受客户端传入（防篡改）
//   - 汇兑损益线索：voucher.exchangeRate（收款日快照）vs settlement.fxRate（结汇日实际）
//   - 软删（deletedAt），删除即回滚核销余额（无独立状态机——水单是事实记录）
// ════════════════════════════════════════════════════════════════════
model FxSettlement {
  id               String @id // 格式：FXS__${shortId}
  settlementNumber String @unique // 结汇水单号（如 FXS-20260808-001）

  // ─── 核销关联（snapshot FK） ───
  voucherId          String  // 关联收款凭证（settlesVoucher linkKind）
  orderId            String? // 冗余关联订单（aboutOrder linkKind），便于按订单聚合
  customerRelationId String? // 交易对象（billTo linkKind）

  // ─── 结汇信息 ───
  settleDate    String  // 结汇日期 YYYY-MM-DD
  foreignAmount Decimal @db.Decimal(18, 4) // 结汇外币金额（≤ 凭证未结汇余额，币种须与凭证一致）
  currency      String  // 外币币种（与凭证币种一致；CNY 凭证无结汇语义，fail closed）
  fxRate        Decimal @db.Decimal(18, 8) // 结汇汇率（外币 → CNY）
  cnyAmount     Decimal @db.Decimal(18, 4) // 折合人民币（服务端计算 = foreignAmount × fxRate）

  // ─── 银行信息 ───
  bank       String? // 结汇银行
  slipNumber String? // 银行水单号

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([voucherId])
  @@index([orderId])
  @@index([customerRelationId])
  @@index([settleDate])
}

// ════════════════════════════════════════════════════════════════════
// OutwardRemittance — 付汇水单（阶段 C6，镜像 FxSettlement 付款侧）
// ════════════════════════════════════════════════════════════════════
// 业务语义：付款凭证（PaymentVoucher type=Disbursement，外币）→ 银行购汇/自有外汇 → 境外付汇。
//   - 一笔外币付款可分次付汇（1 voucher : N remittances），未付余额 = voucher.amount - Σremittances.foreignAmount
//   - cnyAmount 由服务端按 foreignAmount × fxRate 计算（round4），不接受客户端传入（防篡改）
//   - CNY 凭证无付汇语义（fail closed）；Receipt 凭证走 FxSettlement 结汇路径
//   - 软删（deletedAt），删除即回滚未付余额（无独立状态机——水单是事实记录）
// ════════════════════════════════════════════════════════════════════
model OutwardRemittance {
  id               String @id // 格式：OWR__${shortId}
  remittanceNumber String @unique // 付汇水单号（如 OWR-20260808-001）

  // ─── 核销关联（snapshot FK） ───
  voucherId          String  // 关联付款凭证（paysVoucher linkKind）
  orderId            String? // 冗余关联订单（aboutOrder linkKind），便于按订单聚合
  customerRelationId String? // 交易对象（billTo linkKind）

  // ─── 付汇信息 ───
  remitDate     String  // 付汇日期 YYYY-MM-DD
  foreignAmount Decimal @db.Decimal(18, 4) // 付汇外币金额（≤ 凭证未付余额，币种须与凭证一致）
  currency      String  // 外币币种（与凭证币种一致；CNY 凭证无付汇语义，fail closed）
  fxRate        Decimal @db.Decimal(18, 8) // 购汇汇率（外币 → CNY）
  cnyAmount     Decimal @db.Decimal(18, 4) // 折合人民币（服务端计算 = foreignAmount × fxRate）

  // ─── 境外收款方 ───
  payeeName  String? // 收款人名称
  payeeBank  String? // 收款行
  payeeSwift String? // SWIFT 代码
  purpose    String? // GoodsPayment(货款) | Freight(运费) | Insurance(保费) | Commission(佣金) | Other

  // ─── 银行信息 ───
  bank       String? // 付汇银行
  slipNumber String? // 银行水单号

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([voucherId])
  @@index([orderId])
  @@index([customerRelationId])
  @@index([remitDate])
}

// ════════════════════════════════════════════════════════════════════
// VatInvoice — 增值税发票（阶段 C6，退税合规硬前提）
// ════════════════════════════════════════════════════════════════════
// 业务语义：外贸企业「免退」办法下，出口退税 = 进项专票注明金额 × 退税率，
//   无增值税专用发票无退税。本模型管理专票全生命周期：
//   收票(Received) → 勾选认证(Verified) → 申报退税(Declared) → 红冲(RedFlushed) / 作废(Cancelled)
// 设计决策：
//   - 金额三栏服务端校验：totalAmount == round4(netAmount + taxAmount) 精确一致；
//     taxAmount vs round4(netAmount × taxRate/100) 容差 0.02（开票尾差）
//   - 退税联动：→Declared 强制 direction=Input + invoiceType=Special + taxRefundId 有效（未软删）
//   - 唯一性：(vatCode, vatNumber) 复合唯一；全电票 vatCode 为 NULL（PG NULL 不参与唯一冲突），
//     由应用层事务内查重兜底（fail closed）
//   - 红冲/作废为终态；Declared 不可删除（税务留痕），仅可红冲
// ════════════════════════════════════════════════════════════════════
model VatInvoice {
  id String @id // 格式：VAT__${shortId}

  // ─── 税务标识 ───
  vatCode   String? // 发票代码（纸质 10/12 位；全电票无代码）
  vatNumber String // 发票号码（纸质 8 位；全电票 20 位）

  // ─── 类型/状态 ───
  direction   String @default("Input") // Input(进项-采购取得) | Output(销项-内销开出)
  invoiceType String @default("Special") // Special(专票) | Normal(普票)
  status      String @default("Received") // Received | Verified | Declared | RedFlushed | Cancelled

  // ─── 开票方/受票方 ───
  sellerName  String  // 销售方名称
  sellerTaxNo String? // 销售方纳税人识别号
  buyerName   String  // 购买方名称
  buyerTaxNo  String? // 购买方纳税人识别号

  // ─── 金额（专票三栏拆分） ───
  issueDate   String  // 开票日期 YYYY-MM-DD
  netAmount   Decimal @db.Decimal(18, 4) // 不含税金额
  taxRate     Decimal @db.Decimal(6, 4) // 税率(%)，如 13.0000
  taxAmount   Decimal @db.Decimal(18, 4) // 税额
  totalAmount Decimal @db.Decimal(18, 4) // 价税合计 = netAmount + taxAmount
  currency    String  @default("CNY")

  // ─── 认证/勾选 ───
  verifiedDate    String? // 勾选认证日期 YYYY-MM-DD
  deductionPeriod String? // 勾选所属期 YYYY-MM

  // ─── 退税联动 ───
  taxRefundId String? // 关联退税申报（→Declared 必填；declaredInRefund linkKind）

  // ─── 红冲 ───
  redFlushNumber String? // 红字发票号码
  redFlushDate   String? // 红冲日期 YYYY-MM-DD

  // ─── 关联（snapshot FK） ───
  invoiceId  String? // 关联业务发票（应付/应收 Invoice；settlesInvoice linkKind）
  orderId    String? // 关联订单（aboutOrder linkKind）
  relationId String? // 供应商/客户（billTo linkKind）

  // ─── 备注 / 附件 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@unique([vatCode, vatNumber])
  @@index([status])
  @@index([direction])
  @@index([relationId])
  @@index([taxRefundId])
  @@index([invoiceId])
  @@index([issueDate])
}

// ════════════════════════════════════════════════════════════════════
// Shipping Module — 货运与报关
// ════════════════════════════════════════════════════════════════════
// 设计决策：
//   - 金额字段统一 Decimal(18,4) — 第一个 Decimal-first 新模型，
//     旧模块金额字段已同步迁移至 Decimal（Phase 3 完成）。
//   - 重量/体积用 Decimal(12,3)，精度到克/cm³。
//   - 业务日期用 String YYYY-MM-DD，时间戳用 BigInt epoch ms —— 与 Finance 一致。
//   - Relation 关联用 snapshot FK 风格，不加 @relation。
//   - ShipmentLine 代表运单下的装箱明细行（1运单:N行），
//     每行关连 OrderLine（loadedWith linkKind）。
// ════════════════════════════════════════════════════════════════════

model Shipment {
  id             String @id // 格式：SHP__${shortId}
  shipmentNumber String @unique // 运单号（如 SHP-20260615-001）

  // ─── 业务字段 ───
  type           String // Export(出口) | Import(进口) | Domestic(内贸)
  status         String // Draft(草稿) | Booked(已订舱) | Loading(装货中) | Shipped(已发运) | Arrived(已到港) | Cleared(已清关) | Delivered(已交付) | Cancelled(已取消)
  shippingMethod String // Sea(海运) | Air(空运) | Land(陆运) | Rail(铁运) | Courier(快递)

  // ─── 日期 ───
  bookingDate String? // 订舱日期 YYYY-MM-DD
  etd         String? // 预计离港日 Estimated Time of Departure
  atd         String? // 实际离港日 Actual Time of Departure
  eta         String? // 预计到港日 Estimated Time of Arrival
  ata         String? // 实际到港日 Actual Time of Arrival

  // ─── 运输信息 ───
  vesselOrFlight  String? // 船名/航班号
  voyageNumber    String? // 航次号
  portOfLoading   String? // 装货港
  portOfDischarge String? // 卸货港
  containerNumber String? // 集装箱号
  sealNumber      String? // 封条号

  // ─── 重量/体积 ───
  totalPackages Int? // 总件数
  grossWeight   Decimal? @db.Decimal(12, 3) // 毛重(kg)
  netWeight     Decimal? @db.Decimal(12, 3) // 净重(kg)
  volume        Decimal? @db.Decimal(12, 3) // 体积(CBM)

  // ─── 费用（Decimal-first） ───
  freightAmount        Decimal? @db.Decimal(18, 4) // 运费
  freightCurrency      String? // 运费币种
  insuranceAmount      Decimal? @db.Decimal(18, 4) // 保险费
  insuranceCurrency    String? // 保险费币种
  customsAmount        Decimal? @db.Decimal(18, 4) // 报关费
  customsCurrency      String? // 报关费币种
  otherCharges         Decimal? @db.Decimal(18, 4) // 其他费用
  otherChargesCurrency String? // 其他费用币种

  // ─── 关联（snapshot FK） ───
  orderId            String? // 关联订单（aboutOrder linkKind）
  customerRelationId String? // 客户（billTo linkKind）
  customerName       String? // 冗余快照
  carrierRelationId  String? // 货代/船公司（shipsVia linkKind）
  carrierName        String? // 冗余快照

  // ─── 报关 ───
  hsCode                   String? // 海关HS编码（统一编码，行级在 ShipmentLine）
  customsBroker            String? // 报关行
  customsDeclarationNumber String? // 报关单号
  customsClearanceDate     String? // 清关日期

  // ─── 备注 / 附件 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type])
  @@index([status])
  @@index([orderId])
  @@index([customerRelationId])
  @@index([carrierRelationId])
  @@index([shipmentNumber])
  @@index([etd])
}

model ShipmentLine {
  id         String @id // 格式：SHPL__${shortId}
  shipmentId String // 所属运单

  // ─── 行号 ───
  lineNumber Int

  // ─── 关联订单明细行 ───
  orderLineId String? // 关联 OrderLine（loadedWith linkKind）

  // ─── 产品信息（冗余快照，从 OrderLine 带出） ───
  productCode String?
  productName String?
  colorCode   String?
  quantity    Int?
  unit        String? // e.g. "m", "yd", "kg", "pcs"

  // ─── 箱规/包装 ───
  cartons     Int? // 箱数
  grossWeight Decimal? @db.Decimal(12, 3) // 毛重(kg)
  netWeight   Decimal? @db.Decimal(12, 3) // 净重(kg)
  volume      Decimal? @db.Decimal(12, 3) // 体积(CBM)

  // ─── 海关 ───
  hsCode          String? // 行级HS编码（可能与运单级不同）
  countryOfOrigin String? // 原产地

  // ─── 时间戳 ───
  createdAt BigInt
  updatedAt BigInt

  @@index([shipmentId])
  @@index([orderLineId])
}

// ShipmentEvent：运单物流节点事件（F3 lifecycle 深化）
// 每次状态机转换在事务内追加一条节点事件，形成可回溯的
// 订舱→装货→发运→到港→清关→交付 物流时间轴（独立于通用 auditLog，
// 面向业务查询与前端时间轴渲染；append-only，无软删）。
model ShipmentEvent {
  id         String @id // 格式：SHPE__${shortId}
  shipmentId String // 关联运单

  // ─── 节点信息 ───
  fromNode String? // 上一节点（首节点为 null）
  toNode   String // 到达节点（取值与运单状态一致：Draft | Booked | Loading | Shipped | Arrived | Cleared | Delivered | Cancelled）

  eventDate String // 节点业务日期 YYYY-MM-DD（优先取对应业务日期：Shipped→atd / Arrived→ata / Cleared→清关日 / Booked→订舱日，兜底当日）
  note      String? // 节点备注（船名航次 / 异常说明等）
  actorId   String? // 操作人

  createdAt BigInt

  @@index([shipmentId])
  @@index([toNode])
}

// ════════════════════════════════════════════════════════════════════
// End of Shipping Module
// ════════════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════════════════════
// Production Pipeline Module — 大货十阶段生产管线 (Phase 1-2)
// ════════════════════════════════════════════════════════════════════
// 业务规定: 10 阶段门禁式推进
//   ① order_placed → ② materials_confirmed → ③ production_planned
//   → ④ in_production → ⑤ materials_arrived → ⑥ pre_cut_checked
//   → ⑦ pp_sample_approved → ⑧ manufacturing → ⑨ final_review
//   → ⑩ qc_shipped
// 门禁: ⑥ 需 PreCutChecklist 四项全 true; ⑦ 需双签;
//       ⑩ 需验货 passRate≥90% + defectRate≤3% + 业务部批准
// ════════════════════════════════════════════════════════════════════

model ProductionStage {
  id        String  @id // 格式: PST__${orderId}__${stageKey}
  orderId   String
  stageKey  String // order_placed | materials_confirmed | ...
  stageSeq  Int // 1-10 序号
  status    String  @default("pending") // pending | in_progress | done | blocked
  note      String?
  operator  String?
  startedAt BigInt?
  doneAt    BigInt?

  // 双签审批（用于 pp_sample_approved 阶段：生产部+业务部双签）
  signedByProduction String?
  signedByBusiness   String?
  signedAtProduction BigInt?
  signedAtBusiness   BigInt?

  createdAt BigInt
  updatedAt BigInt

  @@unique([orderId, stageKey])
  @@index([orderId])
  @@index([status])
}

model PreCutChecklist {
  id                   String  @id // 格式: PCL__${orderId}
  orderId              String  @unique
  gradingConfirmed     Boolean @default(false) // 推码确认
  consumptionConfirmed Boolean @default(false) // 耗料确认
  patternConfirmed     Boolean @default(false) // 样板确认
  preProductionMeeting Boolean @default(false) // 产前会议
  meetingNote          String?
  confirmedBy          String?
  confirmedAt          BigInt?

  createdAt BigInt
  updatedAt BigInt

  @@index([orderId])
}

// ════════════════════════════════════════════════════════════════════
// Phase B4 扩展：QC 验货报告（中期 + 终期多份）
//   - (orderId, inspectionType) 复合唯一：每单可有 midline(中期验货) 与
//     final(终期/出货前验货) 各一份报告；终期报告是 qc_shipped 门禁判据。
//   - AQL 抽样字段 + 三级疵点计数（critical 零容忍 / major / minor）。
//   - result: pass | conditional | fail（fail 后可整改重验，覆盖更新）。
// ════════════════════════════════════════════════════════════════════
model InspectionReport {
  id                 String  @id // final: INR__${orderId}；midline: INR__${orderId}__midline
  orderId            String
  inspectionType     String  @default("final") // midline(中期验货) | final(终期/出货前验货)
  totalUnits         Int     @default(0)
  passedUnits        Int     @default(0)

  // ─── QC 明细（Phase B4） ───
  inspectionDate   String? // YYYY-MM-DD
  inspectorOrg     String? // 验货方：自有 QC | SGS | BV | Intertek | 客户验货员 ...
  aqlLevel         String? // 例 "2.5/4.0 II"（major/minor AQL + 检验水平）
  lotSize          Int?    // 批量
  sampleSize       Int?    // 抽样数
  criticalDefects  Int     @default(0) // 致命疵点（AQL 0，>0 即整批拒收）
  majorDefects     Int     @default(0) // 主要疵点
  minorDefects     Int     @default(0) // 次要疵点
  defectSummary    String? // 疵点描述（如 "跳线x3 污渍x2"）
  result           String? // pass | conditional | fail
  shipmentId       String? // 关联运单（终期验货对应出运批次）

  reportFile         String?
  inspectedBy        String?
  approvedByBusiness Boolean @default(false)
  businessApprover   String?
  approvedAt         BigInt?
  notes              String?

  createdAt BigInt
  updatedAt BigInt

  @@unique([orderId, inspectionType])
  @@index([orderId])
}

// ════════════════════════════════════════════════════════════════════
// Email Module — 邮件接收与附件存储 (Phase 4a)
// ════════════════════════════════════════════════════════════════════
// 设计决策：
//   - 邮件从 IMAP 实时获取 → 改为 IMAP→DB 后台同步 + API 读 DB，
//     大幅减少 IMAP 连接频率，支持离线查阅和 Agent 引用。
//   - 附件下载到本地 uploads/ 目录，路径存 EmailAttachment.filePath。
//   - 业务日期用 String YYYY-MM-DD，时间戳用 BigInt epoch ms —— 与其他模块一致。
//   - Relation 关联用 snapshot FK 风格，不加 @relation。
//   - EntityLink: email→order(aboutOrder), email→contact(sentBy/receivedFrom),
//     email→invoice(aboutInvoice) — 供 Agent 跨模块查询。
// ════════════════════════════════════════════════════════════════════

model Email {
  id        String  @id // 格式：EML__${shortId}
  messageId String? @unique // RFC 2822 Message-ID header (e.g. "<abc@mail.com>")

  // ─── 方向与状态 ───
  direction String // inbound(收到) | outbound(发出) | draft(草稿)
  status    String // new(未读) | read(已读) | starred(星标) | important(重要) | archived(归档) | deleted(已删)

  // ─── 发件/收件 ───
  fromAddress    String // 发件人邮箱
  fromName       String? // 发件人显示名
  toAddresses    String // 收件人 (JSON array: ["a@b.com","c@d.com"])
  ccAddresses    String? // 抄送 (JSON array)
  bccAddresses   String? // 密送 (JSON array)
  replyToAddress String? // 回复地址

  // ─── 邮件内容 ───
  subject  String
  bodyText String? // 纯文本正文
  bodyHtml String? // HTML 正文
  snippet  String? // 预览片段 (自动从 bodyText 截取前 200 字)

  // ─── IMAP 元数据 ───
  mailbox     String // IMAP 邮箱名 (INBOX, Sent Messages, Drafts, etc.)
  uid         Int? // IMAP UID (同一 mailbox 内唯一)
  uidValidity String? // IMAP UIDVALIDITY (用于跨会话 UID 稳定性)
  threadId    String? // 邮件线索 ID (基于 References/In-Reply-To)

  // ─── 日期 ───
  sentAt     String? // 邮件 Date header (YYYY-MM-DD HH:mm:ss)
  receivedAt String? // 实际收到时间 (YYYY-MM-DD HH:mm:ss)

  // ─── 关联（snapshot FK） ───
  relationId    String? // 关联联系人/组织 (sentBy/receivedFrom linkKind)
  relationName  String? // 冗余快照
  orderId       String? // 关联订单 (aboutOrder linkKind)
  orderPo       String? // 冗余快照：订单 PO 号
  invoiceId     String? // 关联发票 (aboutInvoice linkKind)
  invoiceNumber String? // 冗余快照

  // ─── 分类/标签 ───
  labels          String[] // Gmail-style 标签 (如 ["urgent","peerless","quote"])
  aiSummary       String? // AI 生成的邮件摘要 (Phase 4b)
  aiExtractedJson Json? // AI 抽取的结构化数据 (intent/products/quantities/prices/deadlines/customerSignal/language/summary) - Phase 4b
  aiExtractedAt   BigInt? // AI 抽取时间 epoch ms - Phase 4b
  aiModel         String? // 用于抽取的模型名 (如 ark-code-latest) - Phase 4b
  aiExtractError  String? // 上次抽取失败的错误信息（成功后清零）- Phase 4b

  // ─── 附件统计 ───
  hasAttachments  Boolean @default(false)
  attachmentCount Int     @default(0)

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?
  syncedAt  BigInt? // 最后一次 IMAP 同步时间

  attachments EmailAttachment[]

  @@index([direction])
  @@index([status])
  @@index([fromAddress])
  @@index([mailbox])
  @@index([uid, uidValidity])
  @@index([threadId])
  @@index([relationId])
  @@index([orderId])
  @@index([invoiceId])
  @@index([sentAt])
  @@index([hasAttachments])
}

model EmailAttachment {
  id      String @id // 格式：EMLATT__${shortId}
  emailId String // 所属邮件

  // ─── 附件元数据 ───
  filename    String // 原始文件名
  contentType String // MIME 类型 (e.g. "application/pdf")
  fileSize    Int // 文件大小 (bytes)
  contentId   String? // CID (inline 图片引用)

  // ─── 存储 ───
  filePath String? // 本地存储路径 (uploads/email-attachments/...)
  fileUrl  String? // 可访问 URL (/api/v1/email/attachments/:id/download)
  isInline Boolean @default(false) // 是否内嵌图片

  // ─── 解析后信息 (Phase 4b AI) ───
  extractedText String? // PDF/图片 OCR 提取文本
  aiAnalysis    Json? // AI 分析结果

  // ─── 时间戳 ───
  createdAt BigInt
  updatedAt BigInt

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([contentType])
  @@index([filename])
}

// EmailTemplate：业务场景邮件模板（F5 邮件智能化）
// 报价/催款/交期通知/验货报告/节日问候等标准模板（PRD 12.1）。
// subject/body 支持 {{variable}} 占位符，插入时由前端变量表单填充；
// variables 冗余存储模板中出现的变量名，供 UI 直接生成填写项。
model EmailTemplate {
  id   String @id // 格式：EMTPL__${shortId}
  type String // quote | payment_reminder | delivery_notice | inspection_report | greeting | general

  name      String // 模板名称（如：标准报价函）
  subject   String // 主题模板（支持 {{var}}）
  body      String // 正文模板（支持 {{var}}）
  variables String[] // 变量清单（如 ["customerName","quotationNo"]）

  isActive Boolean @default(true)

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type])
  @@index([isActive])
}

// ════════════════════════════════════════════════════════════════════
// End of Email Module
// ════════════════════════════════════════════════════════════════════

model AuditLog {
  id            String   @id
  actorId       String
  action        String
  targetType    String?
  targetId      String?
  detail        Json?
  ip            String?
  // Phase 0 Sprint 1: 字段级审计（before/after 单字段追踪）
  operationType String? // create / update / delete / transition / link / unlink
  fieldPath     String? // 如 "status" 或 "lines[0].quantity"
  beforeValue   Json?
  afterValue    Json?
  transactionId String? // 关联 OrderStatusTransition / BusinessEvent id，用于串联同一业务操作
  createdAt     DateTime @default(now())

  actor UserAccount @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([transactionId])
}

// ════════════════════════════════════════════════════════════════════
// Notification Module (Phase 0 Sprint 1: 通知系统)
// ════════════════════════════════════════════════════════════════════
// 站内/邮件/Push 多通道通知，由 BusinessEventBus 事件触发，
// 用户可通过 NotificationPreference 配置各类型通知的通道偏好。

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // order_confirmed / shipment_completed / invoice_issued / payment_received / stock_low / payment_overdue / agent_message / briefing
  title     String
  body      String
  level     String    @default("info") // info / warning / critical
  link      String? // 前端跳转路由
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user UserAccount @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([type])
  @@index([createdAt])
  @@index([level])
}

model NotificationTemplate {
  id             String   @id
  key            String   @unique // e.g. "order_confirmed"
  titleTemplate  String // e.g. "订单 {poNumber} 已确认"
  bodyTemplate   String // e.g. "客户 {customer} 的订单已确认..."
  level          String   @default("info")
  defaultChannel String   @default("in_app") // in_app / email / push
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([key])
  @@index([isActive])
}

model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String
  notificationType String // 与 Notification.type 对应
  channels         Json // ["in_app", "email"] — 用户偏好的通道
  isEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user UserAccount @relation(fields: [userId], references: [id])

  @@unique([userId, notificationType])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════════
// Compiled Templates Module (Phase 6)
// ════════════════════════════════════════════════════════════════════
// 模板渲染产物存档：用于 audit + 幂等去重 + 给客户复发同一份发票。
// 不强制每次 render 都写一条；调用方按需选择是否落库。

model RenderedDoc {
  id                 String   @id
  templateId         String // 例如 'invoice.sample.pdas'
  schemaVersion      Int // 模板版本，破坏性变更时 +1
  inputJson          Json // 渲染时传入的 data，用于复现
  htmlSha            String // sha256(html)[:16]
  htmlBytes          Int
  pdfSha             String? // 如生成了 PDF
  pdfBytes           Int?
  pdfPath            String? // 落到 storage/rendered/<id>.pdf
  format             String? // 'A4' | 'A5' | 'Letter'
  landscape          Boolean? @default(false)
  // 业务关联（可空）
  invoiceId          String?
  orderRelationId    String?
  customerRelationId String?
  // 操作者（可空，HTTP 路由 / agent 工具均可写）
  actorId            String?
  actorRoles         Json?
  source             String   @default("api") // 'api' | 'agent' | 'frontend'
  notes              String?
  createdAt          BigInt
  updatedAt          BigInt

  @@index([templateId])
  @@index([htmlSha])
  @@index([invoiceId])
  @@index([orderRelationId])
  @@index([customerRelationId])
  @@index([createdAt])
}

/// Agent checkpoint for crash recovery (checkpoint/resume capability)
model AgentCheckpoint {
  id             String   @id
  conversationId String   @unique
  step           Int
  message        String
  scratchpad     Json // { thoughts: [], toolCalls: [] }
  iterations     Json // IterationTrace[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([conversationId])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════════
// Workflow Engine (Phase 0 · Sprint 2)
// ════════════════════════════════════════════════════════════════════
// 多步审批 / 会签 / 条件分支的状态机引擎。
// WorkflowDefinition = 模板（哪些步骤、每步谁审批）
// WorkflowInstance   = 一次具体审批流程实例（绑定到某个业务实体）
// WorkflowStep       = 实例中的每一步审批记录

/// 工作流定义模板 — 可复用的审批流程蓝图
model WorkflowDefinition {
  id           String   @id
  name         String
  description  String?
  entityType   String // 'Order' | 'Invoice' | 'Shipment' | 'DevelopmentCase' | etc.
  triggerEvent String? // e.g. 'OrderConfirmed' — 事件总线收到此事件时自动创建实例
  steps        Json // Array<StepDef>: { name, approverRole?, approverUserId?, description? }
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instances WorkflowInstance[]

  @@index([entityType])
  @@index([triggerEvent])
  @@index([isActive])
}

/// 工作流实例 — 一次具体的审批流程，绑定到某个业务实体
model WorkflowInstance {
  id               String             @id
  definitionId     String
  definition       WorkflowDefinition @relation(fields: [definitionId], references: [id])
  entityType       String // 'Order' | 'Invoice' | etc.（冗余存储，便于查询）
  entityId         String // 业务实体 ID
  status           String             @default("running") // running | approved | rejected | cancelled
  currentStepIndex Int                @default(0)
  title            String? // 实例标题（如"订单 #PO-001 审批"）
  initiatedById    String?
  initiator        UserAccount?       @relation("WorkflowInitiator", fields: [initiatedById], references: [id])
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  steps WorkflowStep[]

  @@index([definitionId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([initiatedById])
}

/// 工作流步骤 — 实例中每一步的审批记录
model WorkflowStep {
  id             String           @id
  instanceId     String
  instance       WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepIndex      Int
  stepName       String
  approverRole   String? // 角色审批（如 'manager' | 'finance' | 'production_manager'）
  approverUserId String? // 指定用户审批（可选，优先于角色）
  decision       String? // null(待审批) | approved | rejected | skipped
  decisionNote   String?
  decidedById    String?
  decider        UserAccount?     @relation("WorkflowDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([instanceId])
  @@index([decision])
  @@index([approverRole])
}

// ════════════════════════════════════════════════════════════════
// Phase 2: 报价管理 Quotation Management
// 外贸「接单起点」：询价 → 报价 → 样品 → 订单 → 生产 → 发货 → 发票 → 收款
// 报价单是订单的前置环节，accepted 状态可转为 Order
// ════════════════════════════════════════════════════════════════

model Quotation {
  id              String @id // 格式：QT_${shortId}
  quotationNumber String @unique // 业务报价号（如 QT-20260806-001）

  // ─── 业务字段 ───
  status      String // Draft(草稿) | Sent(已发送) | Accepted(已接受) | Rejected(已拒绝) | Expired(已过期)
  currency    String // USD | CNY | EUR ...
  totalAmount Decimal @db.Decimal(18, 4) // 报价总金额（所有行金额合计）

  // ─── 汇率快照（外贸场景） ───
  exchangeRate Decimal? @db.Decimal(18, 4) // 报价当日 currency → baseCurrency 汇率
  baseCurrency String   @default("CNY") // 本位币

  // ─── 关联（snapshot FK，不强制约束） ───
  customerRelationId String? // 结算单位
  customerName       String? // 冗余快照
  customerCode       String? // 客户编码

  // ─── 报价条款 ───
  issueDate     String // 报价日期 YYYY-MM-DD
  validUntil    String? // 报价有效期至 YYYY-MM-DD
  deliveryTerms String? // FOB Shanghai | CIF ...
  paymentTerms  String? // T/T 30% deposit ...
  salesperson   String? // 业务员
  inquiryRef    String? // 询价参考号

  // ─── 转换 ───
  convertedOrderId String? // accepted → 转换为订单后的 orderId

  // ─── 备注 / 附件 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  // ─── 关联行 ───
  lines QuotationLine[]

  @@index([status])
  @@index([customerRelationId])
  @@index([quotationNumber])
  @@index([issueDate])
  @@index([validUntil])
}

model QuotationLine {
  id          String @id
  quotationId String
  lineNumber  Int

  // ─── 商品明细 ───
  fabricCode  String? // 面料编码
  description String // 品名描述
  quantity    Decimal @db.Decimal(18, 4)
  unit        String // YD | M | KG | PC | SET
  unitPrice   Decimal @db.Decimal(18, 4) // 单价（报价币种）
  amount      Decimal @db.Decimal(18, 4) // 行金额 = quantity * unitPrice
  notes       String?

  createdAt BigInt

  // ─── 关联 ───
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([fabricCode])
}

// ============ Phase 2 B1: 采购管理 Procurement ============
model PurchaseOrder {
  id       String @id // 格式：PO_${shortId}
  poNumber String @unique // 业务采购单号（如 PO-20260806-001）
  status   String // Draft(草稿) | Sent(已发送) | Confirmed(已确认) | PartiallyReceived(部分到货) | Received(全部到货) | Closed(已关闭) | Cancelled(已取消)

  // ─── 供应商 ───
  supplierRelationId String? // 供应商 Relation ID
  supplierName       String? // 供应商名称（冗余快照）
  supplierCode       String? // 供应商编码

  // ─── 金额 ───
  currency     String // USD | CNY | EUR
  totalAmount  Decimal  @db.Decimal(18, 4) // 采购总金额
  exchangeRate Decimal? @db.Decimal(18, 4)
  baseCurrency String   @default("CNY")

  // ─── 日期 ───
  orderDate            String // 下单日期 YYYY-MM-DD
  expectedDeliveryDate String? // 预计交货日期
  actualDeliveryDate   String? // 实际交货日期

  // ─── 条款 ───
  deliveryTerms String? // 交货条款
  paymentTerms  String? // 付款条款
  shipToAddress String? // 收货地址

  // ─── 关联 ───
  orderId     String? // 关联销售订单（从订单/BOM 触发采购）
  quotationId String? // 关联报价单（可选）
  bomId       String? // 关联 BOM（可选）

  // ─── 采购员 ───
  buyer       String? // 采购员
  notes       String?
  attachments Json?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  lines    PurchaseLine[]
  receipts MaterialReceipt[]

  @@index([status])
  @@index([supplierRelationId])
  @@index([poNumber])
  @@index([orderDate])
  @@index([orderId])
}

model PurchaseLine {
  id              String @id
  purchaseOrderId String
  lineNumber      Int

  // ─── 物料信息 ───
  materialCode  String? // 物料编码（面料编码/辅料编码）
  description   String // 品名描述
  category      String? // Fabric | Trimmings | Accessories | Other
  specification String? // 规格描述

  // ─── 数量价格 ───
  quantity  Decimal @db.Decimal(18, 4) // 订单数量
  unit      String // YD | M | KG | PC | SET
  unitPrice Decimal @db.Decimal(18, 4) // 单价
  amount    Decimal @db.Decimal(18, 4) // 行金额 = quantity * unitPrice

  // ─── 收货跟踪 ───
  receivedQuantity Decimal @default(0) @db.Decimal(18, 4) // 已收数量
  rejectedQuantity Decimal @default(0) @db.Decimal(18, 4) // 不合格数量

  notes String?

  createdAt BigInt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([materialCode])
}

model MaterialReceipt {
  id              String @id // 格式：MR_${shortId}
  receiptNumber   String // 收料单号
  purchaseOrderId String
  status          String // Pending(待检) | Inspected(已检验) | Accepted(合格入库) | Rejected(不合格) | PartiallyAccepted(部分合格)

  // ─── 收货信息 ───
  receivedDate   String // 收货日期
  receivedBy     String? // 收货人
  inspectedBy    String? // 检验员
  inspectionDate String? // 检验日期

  // ─── 仓库 ───
  warehouseId   String? // 收货仓库 ID
  warehouseName String? // 仓库名称（冗余）

  // ─── 检验结果 ───
  totalReceived   Decimal @db.Decimal(18, 4) // 总收货数量
  totalAccepted   Decimal @db.Decimal(18, 4) // 合格数量
  totalRejected   Decimal @db.Decimal(18, 4) // 不合格数量
  rejectionReason String? // 不合格原因
  qualityNotes    String? // 质量备注

  notes     String?
  createdAt BigInt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([status])
  @@index([receivedDate])
}

// ============ 阶段 H H1: 供应商管理 Supplier Management（PRD 13 / 19.18） ============
// 身份真源在 Relation（category=Supplier），FactoryProfile 1:1 承载工厂属性；
// 评分为事务内重算缓存（真源在 FactoryEvaluation 明细），禁止客户端直改。

// FactoryProfile：工厂档案（PRD 13.1）
model FactoryProfile {
  id         String @id // 格式：FACP__${shortId}
  relationId String @unique // 1:1 挂 Relation（供应商组织身份）

  // ─── 产能 ───
  monthlyCapacity Decimal? @db.Decimal(18, 4) // 月产能
  capacityUnit    String? // PC | M（件/米）
  equipmentList   String? // 设备清单
  workerCount     Int? // 工人数量

  // ─── 专长 ───
  specialties String[] // 擅长品类（西装/大衣/衬衫/针织…）

  // ─── 评分缓存（真源 FactoryEvaluation，事务内重算） ───
  qualityScore  Float   @default(0) // 质量综合分 0-100
  deliveryScore Float   @default(0) // 交期达成率 0-100
  priceLevel    String? // High | Mid | Low

  // ─── 合作历史 ───
  firstOrderAt String? // 首次合作日期 YYYY-MM-DD
  totalOrders  Int     @default(0) // 累计订单数
  totalAmount  Decimal @default(0) @db.Decimal(18, 4) // 累计金额

  // ─── 银行信息 ───
  bankName    String? // 开户行
  bankAccount String? // 收款账户
  bankSwift   String? // SWIFT

  // ─── 黑名单（拉黑后新建采购单禁选） ───
  blacklistedAt    BigInt?
  blacklistReason  String?
  blacklistedById  String?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation         Relation                @relation(fields: [relationId], references: [id], onDelete: Cascade)
  evaluations      FactoryEvaluation[]
  certifications   FactoryCertification[]
  capacityCalendar FactoryCapacity[]

  @@index([blacklistedAt])
  @@index([qualityScore])
}

// FactoryEvaluation：工厂评估记录（PRD 13.2）——每次验货/交货的评分明细（append-only 真源）
model FactoryEvaluation {
  id        String @id // 格式：FAEV__${shortId}
  factoryId String

  kind        String // inspection（验货） | delivery（交期）
  score       Float // 0-100
  sourceType  String? // inspectionReport | shipment | purchaseOrder | manual
  sourceId    String?
  evaluatedAt String // 评定日期 YYYY-MM-DD
  note        String?
  actorId     String?

  createdAt BigInt
  deletedAt BigInt?

  factory FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId, kind])
  @@index([sourceType, sourceId])
}

// FactoryCertification：工厂认证记录（PRD 13.1/15.3）——有效期为预警扫描对象
model FactoryCertification {
  id        String @id // 格式：FACR__${shortId}
  factoryId String

  type          String // BSCI | SEDEX | WRAP | ISO9001 | ...
  certificateNo String?
  issuedAt      String? // 签发日期 YYYY-MM-DD
  validUntil    String? // 有效期至 YYYY-MM-DD（null = 长期有效）
  attachmentPath String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  factory FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId])
  @@index([validUntil])
}

// FactoryCapacity：工厂产能日历（PRD 13.3）——capacity 为计划产能；
// 占用量不落地，由服务层按在手采购单（expectedDeliveryDate 落月）实时聚合。
model FactoryCapacity {
  id        String @id // 格式：FACC__${shortId}
  factoryId String

  month    String // YYYY-MM
  capacity Decimal @db.Decimal(18, 4) // 当月计划产能
  unit     String? // PC | M
  note     String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  factory FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@unique([factoryId, month])
  @@index([month])
}

// ============ 阶段 H H2: 季节性与趋势管理 Season & Trend Management（PRD 14） ============
// 季度标签口径：Order.season / ProductAsset.season 为自由文本，Season.code 为注册真源，
// 关联匹配按字符串等值（如 "SS26"），季度回顾按 code 等值聚合订单。

// Season：季度/系列管理（PRD 14.1）——开发日历 + 季度回顾
model Season {
  id   String @id // 格式：SEAS__${shortId}
  code String @unique // SS26 | AW26 | SS27（与 Order.season / ProductAsset.season 等值匹配）
  name String // 显示名（如 2026 春夏）

  startDate String // YYYY-MM-DD
  endDate   String // YYYY-MM-DD

  // 开发日历里程碑：开发→打样→确认→下单→生产→出货
  calendar Json? // [{ key, label, startDate, endDate, note? }]

  status String @default("Planning") // Planning | Active | Closed

  // 季度回顾快照（PRD 14.1：季度结束后生成 接单量/出货量/毛利/客户分析）
  // 真源为订单实时聚合，此字段为生成时点快照，可重生成
  reviewJson Json? // { orderCount, shippedCount, revenue, cost, grossProfit, topCustomers, generatedAt }
  reviewedAt BigInt?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  trendTags  TrendTag[]
  tradeShows TradeShow[]

  @@index([status])
  @@index([startDate])
}

// TrendTag：面料趋势标签（PRD 14.2）——类型封闭集 fabric|color|craft|composition
model TrendTag {
  id       String  @id // 格式：TRDT__${shortId}
  seasonId String? // 关联季度（null = 跨季趋势）

  type        String // fabric | color | craft | composition
  name        String
  description String?
  source      String? // manual | trade_show
  tradeShowId String? // 展会采集来源

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  season      Season?         @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  tradeShow   TradeShow?      @relation(fields: [tradeShowId], references: [id], onDelete: SetNull)
  fabricLinks TrendTagFabric[]

  @@index([seasonId])
  @@index([type])
}

// TrendTagFabric：趋势 ↔ 面料档案关联（PRD 14.2：推荐时优先展示当季趋势面料）
model TrendTagFabric {
  id         String @id // 格式：TRTF__${shortId}
  trendTagId String
  fabricId   String

  note      String?
  createdAt BigInt

  trendTag TrendTag      @relation(fields: [trendTagId], references: [id], onDelete: Cascade)
  fabric   FabricProfile @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@unique([trendTagId, fabricId])
  @@index([fabricId])
}

// TradeShow：展会记录（PRD 14.3）
model TradeShow {
  id       String  @id // 格式：TRDS__${shortId}
  seasonId String? // 归属季度（可空）

  name      String
  location  String?
  startDate String // YYYY-MM-DD
  endDate   String?
  boothNo   String? // 展位号
  attendees String[] // 参展人员

  cost     Decimal? @db.Decimal(18, 4) // 展会费用（ROI 分母）
  currency String?  @default("CNY")

  status String @default("Planned") // Planned | Ongoing | Completed | Cancelled

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  season    Season?         @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  leads     TradeShowLead[]
  trendTags TrendTag[]

  @@index([seasonId])
  @@index([startDate])
  @@index([status])
}

// TradeShowLead：展会线索（PRD 14.3）——转化为 Relation 后订单归入展会 ROI
model TradeShowLead {
  id          String @id // 格式：TRDL__${shortId}
  tradeShowId String

  customerName String // 客户姓名
  company      String?
  country      String?
  email        String?
  phone        String?
  demand       String? // 需求描述

  status String @default("New") // New | Following | Converted | Lost

  // 转化路径：线索 → Relation（客户）→ 订单（ROI 归因）
  convertedRelationId String?
  convertedAt         BigInt?

  nextFollowUpAt String? // 下次跟进日期 YYYY-MM-DD

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  tradeShow TradeShow @relation(fields: [tradeShowId], references: [id], onDelete: Cascade)

  @@index([tradeShowId])
  @@index([status])
  @@index([convertedRelationId])
}

// ============ 阶段 H H3: 风险管理与合规 Risk Management（PRD 15） ============
// 设计口径：
//   - 逾期天数沿用 receivableOverdueDetector 口径：effectiveDue = dueDate ?? issueDate + 30 天
//   - RiskAlert.dedupKey @unique 为幂等真源：同键重复预警在 DB 层拒绝，不产生重复告警
//   - 关联（Order/Relation/CustomsDeclaration）均为 snapshot FK 风格，不加 @relation

// ExchangeRate：汇率档案（PRD 15.1）——currency → CNY 本位币，按 effectiveDate 取最新
model ExchangeRate {
  id            String  @id // 格式：FXR__${shortId}
  currency      String // USD | EUR | HKD ...（归一化大写）
  rate          Decimal @db.Decimal(18, 8) // 1 单位外币兑 CNY
  effectiveDate String // 生效日期 YYYY-MM-DD
  source        String  @default("manual") // manual | api
  note          String?
  createdAt     BigInt

  @@index([currency, effectiveDate])
}

// FxRateLock：大额订单汇率锁定（PRD 15.1）——锁定期间不受波动影响
model FxRateLock {
  id         String  @id // 格式：FXL__${shortId}
  orderId    String // 关联订单（snapshot FK）
  currency   String // 锁定币种（归一化大写）
  rate       Decimal @db.Decimal(18, 8) // 锁定汇率（外币 → CNY）
  lockedAt   BigInt
  lockedById String?
  note       String?
  createdAt  BigInt
  deletedAt  BigInt?

  @@index([orderId])
}

// CreditRating：信用评级（PRD 15.2）——append-only 评估历史，最新一条为当前评级
// factors 记录评估因子快照：{ onTimeRate, overdueCount, maxDaysOverdue, cooperationYears, settledCount }
model CreditRating {
  id          String  @id // 格式：CDR__${shortId}
  relationId  String // 关联客户（snapshot FK）
  grade       String // A | B | C | D
  score       Float // 0-100
  factors     Json
  evaluatedAt BigInt
  evaluatedBy String? // null = 系统自动评估
  createdAt   BigInt

  @@index([relationId, evaluatedAt])
}

// ComplianceCheck：合规检查记录（PRD 15.3）——HS Code / 出口管制 / 原产地规则
model ComplianceCheck {
  id          String  @id // 格式：CPC__${shortId}
  type        String // hs_code | export_control | origin_rule
  targetType  String // CustomsDeclaration | Order | ProductAsset
  targetId    String
  result      String // pass | warn | fail
  summary     String
  details     Json?
  checkedById String? // null = 系统自动
  checkedAt   BigInt
  createdAt   BigInt

  @@index([type])
  @@index([targetType, targetId])
  @@index([result])
}

// RiskAlert：统一风险预警中心（PRD 15.5）——各维度预警统一落地此处
model RiskAlert {
  id          String  @id // 格式：RSKA__${shortId}
  type        String // fx_volatility | credit_frozen | bad_debt | compliance_fail | quality_repeat
  level       String // info | warning | critical
  title       String
  content     String
  relatedType String?
  relatedId   String?
  dedupKey    String  @unique // 幂等真源：如 bad_debt:${invoiceId} / fx_volatility:${currency}:${date}
  status      String  @default("Open") // Open | Acknowledged | Resolved
  createdAt   BigInt
  updatedAt   BigInt
  resolvedAt  BigInt?

  @@index([type])
  @@index([status])
  @@index([level])
}

// ============ 阶段 P0 回补: 业务线 / QC 工作台（PRD 6.2 / 4.2 / 5.2） ============
// 设计口径：
//   - Order.businessLine 为 BusinessLine.code 的 snapshot 引用（不加 @relation，与全库一致）
//   - 船样/匹头样追踪字段已在 Order（sampleSentDate/fabricSampleSentDate 等），
//     本批次只补「Exmill 前未确认」预警层，不重复建样品模型
//   - QC 人员身份用 UserAccount snapshot FK；QC 任务完成态关联 InspectionReport

// BusinessLine：业务线注册表（PRD 6.2 P0）——影响 MOQ 校验 / 生产流程 / 报表
model BusinessLine {
  id   String @id // 格式：BL__${shortId}
  code String @unique // fabric | garment | capsule
  name String // 面料大货 | 成衣大货 | 成衣 Capsule

  description String?

  // ─── 业务规则基准 ───
  moqValue             Float? // MOQ 校验基准（软校验，产出警示不阻断）
  moqUnit              String? // M | PC
  productionCycleDays  Int? // 生产周期天数（面料 70 天）
  paymentTermsHint     String? // 付款条件提示（T/T 30 天 / T/T 60 天）

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([isActive])
}

// QCLocation：QC 驻地管理（PRD 6.2 P0）——温州（服装）/ 苏州（面料）
model QCLocation {
  id   String @id // 格式：QCL__${shortId}
  code String @unique // wenzhou | suzhou
  name String // 温州驻场 | 苏州驻场

  region  String? // 区域
  focus   String? // 驻地主攻业务线：garment | fabric
  address String?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  assignments QCAssignment[]
}

// QCAssignment：QC 验货任务分配（PRD 6.2 P0 / 4.2 QC 工作台）
model QCAssignment {
  id      String @id // 格式：QCA__${shortId}
  orderId String // 关联订单（snapshot FK）

  inspectionType String // midline（中期验货） | final（终期验货）

  qcUserId          String // 执行 QC（UserAccount snapshot FK）
  locationId        String? // 所属驻地
  factoryRelationId String? // 验货工厂（Relation snapshot FK，冗余自 Order.millRelationId）

  status String @default("Assigned") // Assigned | InProgress | Completed | Cancelled

  dueDate     String? // 要求完成日期 YYYY-MM-DD
  assignedAt  BigInt
  assignedById String?
  completedAt BigInt?
  reportId    String? // 完成后关联 InspectionReport

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  location QCLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([qcUserId, status])
  @@index([orderId])
  @@index([status])
  @@index([dueDate])
}

// ============ 阶段 P1：定价与利润（PRD 8 双轨制 / 6.2 P1 缺口） ============
// 设计口径：
//   - 轨道 A 估算载体为既有 CostEstimate（BOM 模块），本批次不重复建模
//   - 轨道 B 派生值（netUsdCost/profit/commission/finalUnitPrice）一律服务端重算，不接受客户端传入
//   - 汇率/退税率默认值分别取自 ExchangeRate（H3 getLatestRates）与 TaxRefundRate 最长前缀命中
//   - OrderProfitSheet 一单一张（orderId @unique），重生成=覆盖更新，幂等真源为 orderId

// TaxRefundRate：出口退税率表（PRD 8.5 P1）——HS Code → 退税率映射，查询按最长前缀命中
model TaxRefundRate {
  id     String @id // 格式：TRR__${shortId}
  hsCode String @unique // 支持 2/4/6/8/10 位编码
  rate   Decimal @db.Decimal(8, 4) // 退税率百分比（13 = 13%）

  description String?
  isActive    Boolean @default(true)

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([isActive])
}

// PricingCalculation：退税美元定价记录（轨道 B，PRD 8.2/8.6）
model PricingCalculation {
  id String @id // 格式：PRC__${shortId}

  // ─── 输入项 ───
  purchaseCostCny Decimal @db.Decimal(18, 4) // 人民币成本单价（工厂采购价）
  refundRate      Decimal @db.Decimal(8, 4) // 退税率百分比（0-16）
  exchangeRate    Decimal @db.Decimal(18, 8) // CNY per USD（¥/$）
  profitMargin    Decimal @db.Decimal(8, 4) // 利润率百分比
  commissionRate  Decimal @default(0) @db.Decimal(8, 4) // 中间人佣金率（0=无 / 5=E5 / 10=E10）

  // ─── 派生项（服务端重算） ───
  netUsdCost       Decimal @db.Decimal(18, 4) // 退税后美元成本 = purchaseCostCny × (1 - refundRate%) ÷ exchangeRate
  profitAmount     Decimal @db.Decimal(18, 4) // = netUsdCost × profitMargin%
  commissionAmount Decimal @db.Decimal(18, 4) // = netUsdCost × commissionRate%
  finalUnitPrice   Decimal @db.Decimal(18, 4) // 终价美元单价 = netUsdCost + profit + commission

  // ─── 关联（snapshot FK，不强制约束） ───
  orderId        String?
  quotationId    String?
  productAssetId String?
  hsCode         String? // 退税率来源 HS Code（追溯）
  fxLockId       String? // 使用锁定汇率时关联 FxRateLock
  commissionRuleId String? // 佣金率来源 CommissionRule（追溯；rate 已落库为快照）

  quantity Decimal? @db.Decimal(18, 4) // 数量（前端算总额用，不参与单价推导）

  status    String  @default("Draft") // Draft | Confirmed | Archived
  notes     String?
  createdBy String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([orderId])
  @@index([quotationId])
  @@index([status])
}

// OrderProfitSheet：订单级利润表（PRD 6.2 P1 / 8.3 订单利润分析）
// 聚合口径（归一化至 baseCurrency=CNY）：
//   销售收入 = Σ 应收发票（type=Receivable，非 Cancelled）amount × 汇率快照
//   采购成本 = Σ 采购单（非 Cancelled）totalAmount × 汇率快照
//   运费     = Σ 运单（非 Cancelled）freight+insurance+customs+otherCharges（按最新汇率折算）
//   杂费     = Σ 付款凭证（type=Disbursement，orderId 匹配，未核销发票）amount × 汇率快照
//   无可用汇率的外币行不计入合计，列入 details.unconverted 透明披露
model OrderProfitSheet {
  id      String @id // 格式：OPS__${shortId}
  orderId String @unique // 一单一张，重生成=覆盖更新（幂等真源）

  baseCurrency String  @default("CNY")
  salesRevenue Decimal @default(0) @db.Decimal(18, 4)
  purchaseCost Decimal @default(0) @db.Decimal(18, 4)
  freightCost  Decimal @default(0) @db.Decimal(18, 4)
  miscCost     Decimal @default(0) @db.Decimal(18, 4)
  grossProfit  Decimal @default(0) @db.Decimal(18, 4)
  grossMargin  Decimal? @db.Decimal(8, 4) // 毛利率 %（salesRevenue=0 时 null）

  details Json // { sales: [...], purchases: [...], freight: [...], misc: [...], unconverted: [...] }

  version     Int @default(1) // 每次重生成 +1
  generatedAt BigInt

  createdAt BigInt
  updatedAt BigInt

  @@index([generatedAt])
}

// MaterialPriceHistory：原材料价格历史（PRD 8.5 P1，轨道 A 估算校准数据源）
model MaterialPriceHistory {
  id           String @id // 格式：MPH__${shortId}
  materialType String // yarn | fabric | trimming
  materialCode String? // 物料编码（面料/辅料编码，可空=通用行情）
  name         String // 物料名称
  specification String? // 规格描述

  price    Decimal @db.Decimal(18, 4)
  unit     String // M | YD | KG | PC
  currency String  @default("CNY")

  priceDate String // 价格生效日 YYYY-MM-DD
  source    String @default("manual") // manual | purchase-order | quotation

  supplierRelationId String?
  supplierName       String?

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([materialType, materialCode, priceDate])
  @@index([priceDate])
}

// ============ 阶段 P2：佣金规则 / 电子画册 / 面料推荐（PRD 6.2 P2 缺口） ============
// 设计口径：
//   - CommissionRule 是佣金率的配置真源；PricingCalculation.commissionRate 仍落库为数值快照
//     （规则后续调整不回溯历史定价记录），commissionRuleId 记录来源规则以便追溯
//   - LookbookCatalog.items 为 JSON 快照数组：服务端在写操作时从 ProductAsset 重取名称/图片/成本，
//     客户端传入仅作选择依据——画册内容口径以档案真源为准
//   - FabricRecommendation 持久化推荐请求与结果（criteria/results JSON），可审计可复用；
//     打分为服务端确定性算法（非 LLM），同一 criteria 结果可重现

// CommissionRule：中间人佣金规则（PRD 8.5 P2，E5/E10）
// 匹配口径：intermediaryRelationId 精确命中优先；intermediaryRelationId 为空的记录为默认规则兜底
model CommissionRule {
  id   String @id // 格式：CR__${shortId}
  name String // 规则名（如 "E5-某代理"）
  rate Decimal @db.Decimal(8, 4) // 佣金率百分比（5 = E5 / 10 = E10）

  intermediaryRelationId String? // 中间人 Relation snapshot FK（空 = 默认规则）
  intermediaryName       String? // 中间人名称快照（列表展示用）

  isActive Boolean @default(true)
  notes    String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([intermediaryRelationId, isActive])
  @@index([isActive])
}

// LookbookCatalog：电子画册（PRD 6.2 P2）——产品图片 + 描述 + 价格 → Web 预览/打印 PDF
model LookbookCatalog {
  id          String @id // 格式：LB__${shortId}
  title       String
  description String?

  status      String  @default("Draft") // Draft | Published | Archived
  items       Json    @default("[]") // [{ productAssetId, sku, name, description?, price?, currency?, imageUrl?, sortOrder }]
  publishedAt BigInt?

  createdBy String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([status])
  @@index([createdAt])
}

// FabricRecommendation：面料推荐记录（PRD 6.2 P2）
// criteria: { composition?, weightMin?, weightMax?, pattern?, priceMin?, priceMax?, quantity?, targetLeadDays?, limit? }
// results:  [{ productAssetId, sku, name, score, breakdown: { composition, weight, pattern, price, moq, leadTime } }]
model FabricRecommendation {
  id       String @id // 格式：FR__${shortId}
  criteria Json
  results  Json

  createdBy String?
  createdAt BigInt
  deletedAt BigInt?

  @@index([createdAt])
}

// ============ 阶段 P3a: 单据模板与版本（PRD 11.3） ============
// 设计决策：
//   - DocumentTemplate 为每类单据的标准模板（公司抬头/条款/格式），content 为 HTML，支持 {{var}} 占位符；
//     variables 创建/更新时自动从 content 解析（与邮件模板同口径，共享 lib/templateVariables）
//   - isDefault 同 type+language 下唯一（service 事务内清除其他默认），供自动生成草稿时选真源
//   - DocumentVersion 为 TradeDocument 内容变更留痕：版本号按 documentId 单调递增（max+1），
//     content 为变更后整行字段快照（Json），可审计可回溯；版本只增不删（随主单软删隐藏）

// DocumentTemplate：单据模板（PRD 11.3 P1）
model DocumentTemplate {
  id   String @id // 格式：DTPL__${shortId}
  type String // Quotation | SalesConfirmation | ProformaInvoice | CommercialInvoice | PackingList | BillOfLading | AirWaybill | CertificateOfOrigin | InsuranceCert | InspectionCert | InspectionReport | Statement | Other

  name     String // 模板名称（如 "商业发票标准模板-中英"）
  language String @default("bilingual") // zh | en | bilingual

  content   String   // HTML 模板（支持 {{variable}} 占位符）
  variables String[] // 变量清单（自动从 content 解析，冗余存储供 UI 生成填写项）

  isDefault Boolean @default(false) // 同 type+language 下仅一个默认模板
  isActive  Boolean @default(true)

  notes     String?
  createdBy String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([type, language])
  @@index([isDefault])
  @@index([isActive])
}

// DocumentVersion：单据版本留痕（PRD 11.3 P2）
model DocumentVersion {
  id         String @id // 格式：DVER__${shortId}
  documentId String // 关联 TradeDocument（snapshot FK）
  version    Int // 按 documentId 单调递增（1 起）

  content      Json // 变更后单据字段快照
  changeReason String? // 变更原因
  changedBy    String? // 修改人

  createdAt BigInt

  @@unique([documentId, version])
  @@index([documentId])
}

// ============ 阶段 P3b: 品牌线 / 沟通日志 / 邮件签名（PRD 6.2 / 12.1 / 12.3） ============
// 设计决策：
//   - BrandLine 挂 Relation（snapshot FK，不对 Relation 加反向字段，与 CommissionRule 同口径）；
//     同客户下品牌线名称唯一（含软删记录占位，防复活冲突——与 CommissionRule 启用占位同思路）
//   - CommunicationLog 与 FollowUpRecord 分工：FollowUpRecord 是跟进动作（含下次跟进计划/可转任务），
//     CommunicationLog 是全渠道沟通流水（方向 Inbound/Outbound + 渠道 + 摘要 + 邮件/订单/报价关联），
//     客户 360° 时间线由两者共同构成
//   - EmailSignature 同 language 下 isDefault 唯一（service 事务内清除其他默认），
//     content 支持 {{variable}}（共享 lib/templateVariables，与邮件/单据模板同口径）

// BrandLine：客户品牌下的产品线（PRD 6.2 P1）——如某品牌 → 正装线/休闲线/设计师线
model BrandLine {
  id         String @id // 格式：BL__${shortId}
  relationId String // 所属客户 Relation snapshot FK

  name        String // 品牌线名称（同客户下唯一）
  code        String? // 品牌线编码
  description String?

  isActive Boolean @default(true)
  notes    String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([relationId])
  @@index([isActive])
}

// CommunicationLog：沟通日志（PRD 12.3 P1）——全渠道沟通流水
model CommunicationLog {
  id         String @id // 格式：CL__${shortId}
  relationId String // 关联客户 Relation snapshot FK
  contactId  String? // 关联联系人

  type       String // Email | Call | WeChat | Visit | Meeting | Other
  direction  String @default("Outbound") // Inbound | Outbound
  subject    String? // 主题
  summary    String // 沟通摘要
  occurredAt String // 沟通日期 YYYY-MM-DD

  emailMessageId String? // 关联邮件消息（邮件渠道时）
  orderId        String? // 关联订单
  quotationId    String? // 关联报价

  loggedBy  String? // 记录人
  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([relationId])
  @@index([contactId])
  @@index([type])
  @@index([occurredAt])
}

// EmailSignature：邮件签名（PRD 12.1 P2）——统一公司签名格式，含联系方式/地址/银行信息
model EmailSignature {
  id   String @id // 格式：ESIG__${shortId}
  name String // 签名名称（如 "默认英文签名"）

  language  String   @default("bilingual") // zh | en | bilingual
  content   String // 签名内容（HTML/文本，支持 {{variable}} 如 {{senderName}}）
  variables String[] // 自动从 content 解析（冗余存储供 UI 生成填写项）

  isDefault Boolean @default(false) // 同 language 下仅一个默认签名
  isActive  Boolean @default(true)

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([language])
  @@index([isDefault])
  @@index([isActive])
}

// ============ Phase 2 B2: 库存管理 Inventory Management ============

model Warehouse {
  id        String  @id // 格式：WH_${shortId}
  code      String  @unique // 仓库编码（如 WH-001 / SH-MAIN）
  name      String // 仓库名称
  type      String // Main(主仓) | Auxiliary(辅仓) | Temporary(临时仓) | Virtual(虚拟仓)
  address   String? // 仓库地址
  manager   String? // 仓库管理员
  phone     String? // 联系电话
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  notes     String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  items InventoryItem[]

  @@index([type])
  @@index([isActive])
}

model InventoryItem {
  id             String  @id // 格式：INV_${shortId}
  warehouseId    String
  productAssetId String? // 关联产品档案（面料/辅料/成衣）
  materialCode   String? // 物料编码（可独立于产品档案，如临时编码）
  description    String // 品名描述
  category       String? // Fabric | Trimmings | Accessories | Garment | Other
  specification  String? // 规格描述
  batchNumber    String? // 批次号（可追溯）
  locationCode   String? // 库位编码（如 A-01-03）

  // ─── 数量 ───
  quantity       Decimal @db.Decimal(18, 4) // 当前库存数量
  lockedQuantity Decimal @default(0) @db.Decimal(18, 4) // 锁定/预留数量（已分配未出库）
  unit           String // YD | M | KG | PC | SET

  // ─── 成本 ───
  unitCost Decimal? @db.Decimal(18, 4) // 单位成本
  currency String   @default("CNY")

  // ─── 预警 ───
  minStock Decimal? @db.Decimal(18, 4) // 最低库存预警线
  maxStock Decimal? @db.Decimal(18, 4) // 最高库存预警线

  // ─── 日期 ───
  lastInDate  String? // 最后入库日期
  lastOutDate String? // 最后出库日期

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  movements StockMovement[]

  @@index([warehouseId])
  @@index([productAssetId])
  @@index([materialCode])
  @@index([category])
  @@index([batchNumber])
}

model StockMovement {
  id             String @id // 格式：SM_${shortId}
  movementNumber String // 流水单号（如 SM-20260806-001）
  type           String // Inbound(入库) | Outbound(出库) | Transfer(调拨) | Adjustment(盘点调整) | Lock(锁定) | Unlock(解锁)

  // ─── 关联库存项 ───
  itemId            String // 关联 InventoryItem
  warehouseId       String // 操作仓库（源仓库）
  targetWarehouseId String? // 调拨目标仓库（仅 Transfer 类型）

  // ─── 数量 ───
  quantity      Decimal  @db.Decimal(18, 4) // 变动数量（Inbound 正 / Outbound 负 / Transfer 记录绝对值）
  unit          String
  unitCost      Decimal? @db.Decimal(18, 4) // 变动时的单位成本
  balanceBefore Decimal  @db.Decimal(18, 4) // 变动前余额
  balanceAfter  Decimal  @db.Decimal(18, 4) // 变动后余额

  // ─── 来源追溯 ───
  reason        String? // 变动原因
  referenceType String? // PurchaseOrder | Order | Shipment | ProductionStage | Adjustment | Manual
  referenceId   String? // 关联单据 ID

  // ─── 操作人 ───
  operator     String? // 操作人
  movementDate String // 变动日期 YYYY-MM-DD

  notes     String?
  createdAt BigInt

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([type])
  @@index([warehouseId])
  @@index([movementDate])
  @@index([referenceType, referenceId])
}

// ============ Phase 2 B4: BOM / 成本核算 Bill of Materials ============
model BOM {
  id        String @id // 格式：BOM_${shortId}
  bomNumber String @unique // 业务 BOM 号（如 BOM-20260806-001）

  // ─── 业务字段 ───
  status      String // Draft(草稿) | Confirmed(已确认) | Archived(已归档)
  description String // BOM 描述（如：男款西装外套 - 款号 M2026-001）

  // ─── 关联（snapshot FK，不强制约束） ───
  productAssetId String? // 关联产品档案（成衣款式）
  orderId        String? // 关联订单（订单确认后自动生成 BOM）
  quotationId    String? // 关联报价单

  // ─── 版本 ───
  version     Int     @default(1) // BOM 版本号（修订递增）
  parentBomId String? // 上一版本 BOM ID（版本追溯）

  // ─── 成本汇总（料/工/费） ───
  totalMaterialCost Decimal @default(0) @db.Decimal(18, 4) // 物料成本合计
  totalLaborCost    Decimal @default(0) @db.Decimal(18, 4) // 人工成本合计
  totalOverheadCost Decimal @default(0) @db.Decimal(18, 4) // 制造费用合计
  totalCost         Decimal @default(0) @db.Decimal(18, 4) // 总成本 = 物料 + 人工 + 费用
  currency          String  @default("CNY")

  // ─── 利润分析 ───
  sellingPrice Decimal? @db.Decimal(18, 4) // 销售单价
  profitMargin Decimal? @db.Decimal(8, 4) // 利润率（%）
  profitAmount Decimal? @db.Decimal(18, 4) // 利润额 = sellingPrice - totalCost

  // ─── 备注 ───
  notes       String?
  attachments Json?

  // ─── 时间戳 + 软删 ───
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  // ─── 关联行 ───
  lines         BOMLine[]
  costEstimates CostEstimate[]

  @@index([status])
  @@index([productAssetId])
  @@index([orderId])
  @@index([quotationId])
  @@index([bomNumber])
}

model BOMLine {
  id         String @id
  bomId      String
  lineNumber Int

  // ─── 物料明细 ───
  materialType  String // Main(主料) | Contrast(对比料) | Lining(里布) | Pocketing(口袋布) | Trimmings(辅料) | Thread(缝纫线) | Packaging(包装) | Other
  materialCode  String? // 物料编码
  description   String // 品名描述
  category      String? // Fabric | Trimmings | Accessories | Garment | Other
  specification String? // 规格描述
  supplierId    String? // 供应商 ID（snapshot）

  // ─── 用量 + 成本 ───
  quantity       Decimal @db.Decimal(18, 4) // 单件用量
  unit           String // YD | M | KG | PC | SET
  wastagePercent Decimal @default(0) @db.Decimal(8, 4) // 损耗率（%）
  effectiveQty   Decimal @db.Decimal(18, 4) // 实际用量 = quantity * (1 + wastage%)
  unitCost       Decimal @db.Decimal(18, 4) // 单价
  amount         Decimal @db.Decimal(18, 4) // 行金额 = effectiveQty * unitCost
  currency       String  @default("CNY")

  notes     String?
  createdAt BigInt
  updatedAt BigInt

  // ─── 关联 ───
  bom BOM @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([materialCode])
  @@index([materialType])
  @@index([category])
}

model CostEstimate {
  id    String @id
  bomId String

  // ─── 成本类型 ───
  costType    String // Material(物料) | Labor(人工) | Overhead(制造费用) | Other(其他)
  description String // 成本项描述（如：裁剪人工 / 缝纫人工 / 厂房折旧 / 检验费）

  // ─── 金额 ───
  amount   Decimal @db.Decimal(18, 4)
  currency String  @default("CNY")

  // ─── 备注 ───
  notes     String?
  createdAt BigInt
  updatedAt BigInt

  // ─── 关联 ───
  bom BOM @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([costType])
}

// ════════════════════════════════════════════════════════════════════
// Production MES Module — 生产制造执行系统深化 (Phase 3 C2)
// ════════════════════════════════════════════════════════════════════
// 设计决策：
//   - WorkStation: 物理生产资源（缝纫线/裁剪台/印花机等），独立于订单
//   - ProductionPlan: 排产单，将订单工序分配到工位并安排时间
//   - WorkHour: 工时记录，按员工+排产单维度记录
//   - PieceRateRule/Record: 计件工资规则与记录（单价快照防回溯）
//   - OutsourcingOrder/Line: 外协订单管理
//   - 跨模块关联用 snapshot FK 风格（orderId/employeeId/supplierId），不加 @relation
//   - 日期用 String YYYY-MM-DD，时间戳用 BigInt epoch ms
// ════════════════════════════════════════════════════════════════════

model WorkStation {
  id   String @id // 格式：WS_${shortId}
  code String @unique // 工位编码（如 WS-001 / SEW-LINE-A）
  name String // 工位名称
  type String // Sewing(缝纫) | Cutting(裁剪) | Printing(印花) | Embroidery(绣花) | Packing(包装) | QC(质检) | Other(其他)

  // ─── 产能 ───
  capacityPerDay Decimal? @db.Decimal(18, 4) // 日产能（单位/天）
  capacityUnit   String? // 产能单位（PC / SET / DZ）

  // ─── 状态 ───
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // ─── 其他 ───
  location String? // 工位位置（车间/楼层）
  manager  String? // 工位负责人
  notes    String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  productionPlans ProductionPlan[]

  @@index([type])
  @@index([isActive])
}

model ProductionPlan {
  id         String @id // 格式：PP_${shortId}
  planNumber String @unique // 排产单号（如 PP-20260807-001）

  // ─── 关联 ───
  orderId       String? // 关联订单（跨模块 snapshot FK）
  workStationId String

  // ─── 工序类型 ───
  processType String // Sewing | Cutting | Printing | Embroidery | Packing | QC | Other
  processSeq  Int    @default(0) // 工序顺序号

  // ─── 数量 ───
  plannedQuantity Decimal @db.Decimal(18, 4) // 计划数量
  actualQuantity  Decimal @default(0) @db.Decimal(18, 4) // 实际完成数量
  unit            String // PC | SET | DZ

  // ─── 日期 ───
  plannedStartDate String // YYYY-MM-DD
  plannedEndDate   String // YYYY-MM-DD
  actualStartDate  String? // YYYY-MM-DD
  actualEndDate    String? // YYYY-MM-DD

  // ─── 状态 ───
  status   String @default("Draft") // Draft | Confirmed | InProgress | Completed | Cancelled
  priority String @default("Normal") // High | Normal | Low

  // ─── 人员 ───
  assignedTo String? // 负责人

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  workStation WorkStation @relation(fields: [workStationId], references: [id])
  workHours   WorkHour[]

  @@index([orderId])
  @@index([workStationId])
  @@index([status])
  @@index([processType])
}

model WorkHour {
  id               String  @id // 格式：WHR_${shortId}
  productionPlanId String
  employeeId       String? // 员工 ID（跨模块 snapshot FK）
  employeeName     String? // 员工姓名快照

  // ─── 工时 ───
  workDate      String // YYYY-MM-DD
  hours         Decimal @db.Decimal(8, 2) // 正常工时
  overtimeHours Decimal @default(0) @db.Decimal(8, 2) // 加班工时

  // ─── 备注 ───
  notes     String?
  createdAt BigInt
  updatedAt BigInt

  productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)

  @@index([productionPlanId])
  @@index([employeeId])
  @@index([workDate])
}

model PieceRateRule {
  id   String @id // 格式：PRR_${shortId}
  code String @unique // 规则编码（如 PRR-001）
  name String // 规则名称

  // ─── 适用范围 ───
  processType    String // Sewing | Cutting | Printing | Embroidery | Packing | QC | Other
  productAssetId String? // 关联产品档案（跨模块 snapshot FK）

  // ─── 计件标准 ───
  unit        String // PC | SET | DZ | KG | YD
  ratePerUnit Decimal @db.Decimal(18, 4) // 单价

  // ─── 生效期 ───
  effectiveFrom String // YYYY-MM-DD
  effectiveTo   String? // YYYY-MM-DD（null 表示长期有效）

  // ─── 状态 ───
  isActive Boolean @default(true)

  // ─── 其他 ───
  description String?
  notes       String?
  createdAt   BigInt
  updatedAt   BigInt
  deletedAt   BigInt?

  records PieceRateRecord[]

  @@index([processType])
  @@index([productAssetId])
  @@index([isActive])
}

model PieceRateRecord {
  id String @id // 格式：PRC_${shortId}

  // ─── 关联 ───
  pieceRateRuleId  String
  productionPlanId String? // 关联排产单（可选）
  employeeId       String? // 员工 ID（跨模块 snapshot FK）
  employeeName     String? // 员工姓名快照

