generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProjectMemory {
  id          String   @id
  type        String
  layer       String
  content     String
  description String?
  timestamp   BigInt
  deletedAt   BigInt?
  source      String?  @default("ARCHITECT")
  status      String?  @default("STABLE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([layer])
  @@index([type])
}

model BusinessProfile {
  id        String  @id
  kind      String
  name      String
  payload   Json
  assets    Json?
  isActive  Boolean @default(true)
  updatedAt BigInt
  deletedAt BigInt?

  @@index([kind])
  @@index([isActive])
}

model KnowledgeItem {
  id        String  @id
  title     String
  content   String
  category  String
  sourceUrl String?
  updatedAt BigInt
  deletedAt BigInt?

  @@index([category])
}

model Order {
  id          String  @id
  customer    String
  product     String
  type        String
  quantity    Int
  status      String
  dueDate     String
  quoteAmount Decimal @db.Decimal(18, 4)
  updatedAt   BigInt?
  deletedAt   BigInt?

  // --- Imported PO header (nullable for legacy rows) ---
  poNumber       String?  @unique
  customerCode   String?
  season         String?
  poDate         String?
  contactPerson  String?
  contactPhone   String?
  currency       String?
  deliveryTerms  String?
  paymentTerms   String?
  shipToName     String?
  shipToAddress1 String?
  shipToAddress2 String?
  shipToCountry  String?
  shipToPhone    String?
  deliverTo      String?
  totalNet       Decimal? @db.Decimal(18, 4)
  totalActual    Decimal? @db.Decimal(18, 4)
  source         String? // e.g. "pdf-import", "manual"
  importedAt     BigInt?

  // ============ Phase 2: per-field provenance + currency split ============
  /// JSONB map: { [fieldKey]: 'pdf' | 'manual' | 'imported-then-edited' }.
  /// PDF re-import uses this to skip fields the user has manually edited.
  fieldSources     Json?
  purchaseCurrency String? // default 'CNY' for purchase-side amounts
  salesCurrency    String? // default 'USD' for sales-side amounts

  // ============ Phase 2: Role snapshots + Relation FKs ============
  // FKs are *snapshot* references — we do NOT enforce a foreign-key constraint
  // because Relation rows can be archived independently of orders.
  customerAddress    String?
  customerRelationId String?

  // Mill / 面料工厂 / supplier (应付侧)
  millName       String?
  millAddress    String?
  millContact    String?
  millPhone      String?
  millRelationId String?

  // Consignee / 服装厂收货方 (物流目的地)
  consigneeName       String?
  consigneeAddress    String?
  consigneeContact    String?
  consigneeRelationId String?

  // Bill-to / 结款方 (服装厂或其代理)
  billToName       String?
  billToAddress    String?
  billToContact    String?
  billToIsAgent    Boolean?
  billToRelationId String?

  // ============ Internal Team ============
  salesPerson            String?
  salesPersonRelationId  String?
  merchandiser           String?
  merchandiserRelationId String?
  supervisor             String?
  supervisorRelationId   String?

  // ============ Phase 2: Contracts ============
  salesContractNumber String? // 早期销售合同号 (出给客户)
  finalContractNumber String? // 最终销售合同号 (出给 Bill-to)

  // ============ Phase 2: Detail-card rich fields (lifted from localStorage) ============
  // Production / OTS basic
  productionBatch  String?
  productColorCode String?
  clientCode       String? // ZROH 客户编码 (sticky overlay on top of firstLine.materialCode)
  referenceBatch   String?
  productionDate   String? // 生产交期
  clientDate       String? // 出厂交期 (Exmill)

  // Fabric specs (sticky overlay on top of firstLine; PDF supplies fallback)
  fabricCode    String?
  fabricContent String?
  width         String?
  gsm           String?

  // A/S contact (跟单/售后)
  asPerson String?

  // Sales / collection
  salesPrice          Decimal? @db.Decimal(18, 4)
  contractAmount      Decimal? @db.Decimal(18, 4)
  paymentInstrument   String? // T/T, L/C, O/A, D/P, D/A
  expectedPaymentDate String?
  actualPaymentDate   String?
  actualPaymentAmount Decimal? @db.Decimal(18, 4)

  // Shipment & invoice (我方开给 Bill-to)
  invoiceNumber    String?
  invoiceDate      String?
  shipmentDate     String?
  shipmentMethod   String?
  shipmentQuantity Float?
  shipmentAmount   Decimal? @db.Decimal(18, 4)

  // Shipment sample (大货船样)
  sampleSentDate         String?
  sampleConfirmedDate    String?
  sampleTrackingNumber   String?
  shipmentSampleComments String?

  // Fabric sample (匹头样)
  fabricSampleSentDate       String?
  fabricSampleConfirmedDate  String?
  fabricSampleTrackingNumber String?
  paidSampleQuantity         Float?

  // Purchase / supplier invoice (我方付给 Mill)
  purchasePrice         Decimal? @db.Decimal(18, 4)
  purchasePaymentDate   String?
  supplierInvoiceNumber String?
  supplierInvoiceDate   String?
  supplierInvoiceAmount Decimal? @db.Decimal(18, 4)

  // Misc
  specialInstructions String?
  ocDays              Int?

  // ============ 阶段 P0：业务线标记（BusinessLine.code 快照引用，见 H3 后 P0 块） ============
  businessLine String? // fabric | garment | capsule（snapshot，不强制外键）

  // ============ Production pipeline deadlines (业务十条规则) ============
  productionPlanDeadline String? // 下单后7天内需出生产计划（createdAt + 7d），超时触发预警
  delayNoticeDeadline    String? // 交货期前15天需发延期通知（dueDate - 15d），超时升级

  lines             OrderLine[]
  statusTransitions OrderStatusTransition[]

  @@index([status])
  @@index([customerCode])
  @@index([millName])
  @@index([consigneeName])
  @@index([billToName])
  @@index([businessLine])
}

model OrderLine {
  id                  String   @id
  orderId             String
  lineNumber          Int
  itemNo              String?
  materialCode        String?
  millQuality         String?
  description         String?
  width               String?
  exMillDate          String?
  deliveryDate        String?
  quantity            Decimal  @db.Decimal(18, 4)
  unit                String?
  unitPrice           Decimal? @db.Decimal(18, 4)
  netValue            Decimal? @db.Decimal(18, 4)
  via                 String?
  cloth               String?
  weight              String?
  category            String?
  notes               String?
  status              String?  @default("Pending")
  productionBatch     String?
  shippingDate        String?
  shippingMethod      String?
  invoiceNumber       String?
  invoiceDate         String?
  shipmentQuantity    Float?
  shipmentAmount      Decimal? @db.Decimal(18, 4)
  actualPaymentDate   String?
  actualPaymentAmount Decimal? @db.Decimal(18, 4)
  specialInstructions String?
  fieldSources        Json?

  // Garment-specific extension fields
  sizeBreakdown   Json? // { S: 100, M: 200, L: 200, XL: 100, XXL: 50 }
  productionSteps Json? // [ { step: "cutting", status: "done", date: "..." }, ... ]
  styleNo         String? // 款式号 → links to ProductAsset/GarmentProfile
  colorName       String? // 色号名称
  bomItems        Json? // [ { type: "fabric", name: "...", qty: 1.5, unit: "meter" }, ... ]

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, itemNo])
  @@index([orderId])
  @@index([status])
}

model OrderStatusTransition {
  id         String  @id
  orderId    String
  fromStatus String
  toStatus   String
  note       String?
  operator   String?
  lineId     String?
  createdAt  BigInt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([toStatus])
  @@index([createdAt])
}

model Relation {
  id              String   @id
  name            String
  category        String
  type            String
  isOrganization  Boolean
  parentId        String?
  reportsToId     String?
  role            String?
  department      String?
  tags            String[]
  contactInfo     String
  rating          Float    @default(0)
  lastInteraction BigInt
  preferences     String?
  deletedAt       BigInt?

  // Organization fields mirrored by the Relations UI.
  chineseName         String?
  englishName         String?
  creditLevel         String?
  summary             String?
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  backupContacts      Json?
  shipToAddresses     Json?
  financialNotes      String?
  website             String?
  paymentTerms        String?
  paymentPreference   String?
  currency            String?
  taxId               String?
  creditLimit         Decimal? @db.Decimal(18, 4)
  officialAddress     String?
  factoryAddresses    String[]
  warehouseAddress    String?
  billingAddress      String?
  shippingAddress     String?
  coordinatesLat      Float?
  coordinatesLng      Float?

  // Contact fields mirrored by the Relations UI.
  email         String?
  phone         String?
  mobile        String?
  wechat        String?
  whatsapp      String?
  otherContacts Json?
  birthday      String?
  language      String?
  timezone      String?
  personalNote  String?

  // ─── C1 CRM 深化：反向关联 ───
  contacts        Contact[]
  creditLimits    CreditLimit[]
  followUpRecords FollowUpRecord[]
  opportunities   Opportunity[]
  customerTiers   CustomerTier[]
  factoryProfile  FactoryProfile?

  @@index([category])
  @@index([isOrganization])
  @@index([parentId])
}

// ════════════════════════════════════════════════════════════════
// C1 CRM 深化模型（Phase 3）
// 设计目标：将扁平的 Relation 档案升级为结构化 CRM 能力
//   - Contact：多联系人管理（替代 backupContacts JSON blob）
//   - CreditLimit：信用额度与用量跟踪（替代 creditLevel 扁平字段）
//   - FollowUpRecord：销售跟进记录与下次跟进提醒
//   - Opportunity：销售商机管线（Prospecting→ClosedWon/Lost）
//   - CustomerTier：客户分层与权益（Bronze/Silver/Gold/Platinum）
// ════════════════════════════════════════════════════════════════

model Contact {
  id         String @id // 格式：CTC_${shortId}
  relationId String // 关联 Relation

  // ─── 联系人基本信息 ───
  name       String // 姓名
  title      String? // 职位（如：采购经理 / 业务总监）
  department String? // 部门

  // ─── 联系方式 ───
  email    String?
  phone    String?
  mobile   String?
  wechat   String?
  whatsapp String?

  // ─── 角色标记 ───
  isPrimary       Boolean @default(false) // 是否主联系人
  isDecisionMaker Boolean @default(false) // 是否决策人

  // ─── 客情维护 ───
  birthday     String? // 生日（用于客情维护）
  personalNote String? // 个人备注（兴趣爱好等）
  tags         String[] // 标签

  status String @default("Active") // Active | Inactive | Left（离职）

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation        Relation         @relation(fields: [relationId], references: [id], onDelete: Cascade)
  followUpRecords FollowUpRecord[]

  @@index([relationId])
  @@index([isPrimary])
  @@index([status])
}

model CreditLimit {
  id         String @id // 格式：CL_${shortId}
  relationId String // 关联 Relation

  // ─── 信用额度 ───
  totalLimit Decimal @db.Decimal(18, 4) // 总信用额度
  usedAmount Decimal @default(0) @db.Decimal(18, 4) // 已用额度（由订单/发票未收款累计）
  currency   String  @default("CNY")

  // ─── 有效期 ───
  validFrom String // 生效日期 YYYY-MM-DD
  validTo   String? // 失效日期（null = 长期有效）

  // ─── 状态 ───
  status String @default("Active") // Active | Frozen | Expired | Revoked

  // ─── 审批 ───
  approvedBy String? // 审批人
  approvedAt BigInt? // 审批时间

  notes String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
  @@index([status])
}

model FollowUpRecord {
  id         String  @id // 格式：FU_${shortId}
  relationId String // 关联 Relation
  contactId  String? // 关联 Contact（可选）

  // ─── 跟进信息 ───
  type       String // Visit | Call | Email | WeChat | Meeting | Other
  content    String // 跟进内容
  followUpAt String // 跟进日期 YYYY-MM-DD

  // ─── 下次跟进 ───
  nextFollowUpAt    String? // 下次跟进日期
  nextFollowUpTopic String? // 下次跟进主题

  // ─── 关联业务 ───
  opportunityId String? // 关联商机
  orderId       String? // 关联订单

  // ─── 销售代表 ───
  salesRepId   String? // 销售代表
  salesRepName String? // 销售代表姓名（冗余）

  // ─── 附件/备注 ───
  attachments Json?
  notes       String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([relationId])
  @@index([contactId])
  @@index([followUpAt])
  @@index([nextFollowUpAt])
}

model Opportunity {
  id         String @id // 格式：OPP_${shortId}
  relationId String // 关联 Relation

  // ─── 商机信息 ───
  title       String // 商机标题
  description String? // 商机描述

  // ─── 金额 ───
  amount   Decimal @db.Decimal(18, 4) // 预计金额
  currency String  @default("CNY")

  // ─── 阶段（销售管线）───
  stage       String @default("Prospecting") // Prospecting | Qualification | Proposal | Negotiation | ClosedWon | ClosedLost
  probability Int    @default(10) // 成交概率 0-100

  // ─── 日期 ───
  expectedCloseDate String? // 预计成交日期 YYYY-MM-DD

  // ─── 关联 ───
  source  String? // 商机来源（展会 / 转介绍 / 主动开发 / 复购）
  orderId String? // 关联订单（成交后）

  // ─── 归属 ───
  salesRepId   String? // 销售代表
  salesRepName String? // 销售代表姓名（冗余）

  // ─── 备注 ───
  tags  String[]
  notes String?

  // ─── 时间 ───
  closedAt BigInt? // 成交/流失时间

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([salesRepId])
}

model CustomerTier {
  id         String @id // 格式：TIER_${shortId}
  relationId String // 关联 Relation

  // ─── 分层 ───
  level    String // Bronze | Silver | Gold | Platinum | VIP
  criteria String? // 评定依据（如：年采购额 > 100万）

  // ─── 权益 ───
  discountRate     Decimal? @db.Decimal(5, 2) // 折扣率（5.00 = 5%）
  paymentTermsDays Int? // 账期天数
  creditPriority   String   @default("Normal") // 信用优先级：High | Normal | Low

  // ─── 评定 ───
  evaluatedAt String // 评定日期 YYYY-MM-DD
  validUntil  String? // 有效期至（null = 长期有效）
  evaluatedBy String? // 评定人

  notes String?

  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
  @@index([level])
}

model ProductAsset {
  id            String  @id
  sku           String  @unique
  name          String
  mainCategory  String
  subCategoryId String
  season        String
  techPackUrl   String?
  imageUrl      String?
  cost          Decimal @db.Decimal(18, 4)
  status        String
  updatedAt     BigInt
  deletedAt     BigInt?

  fabricProfile        FabricProfile?
  garmentProfile       GarmentProfile?
  trimmingProfile      TrimmingProfile?
  classificationLinks  ProductClassificationLink[]
  fabricCustomerCodes  FabricCustomerCode[]
  fabricPrices         FabricPriceHistory[]
  fabricCertifications FabricCertification[]
  compositionLines     FabricCompositionLine[]
  images               ProductImage[]

  @@index([sku])
  @@index([season])
}

