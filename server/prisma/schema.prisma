// ══════════════════════════════════════════════════════════════════════════════
// Phase 5 B5 + Phase 3 C6: 外贸与报关（CustomsDeclaration / HsCode /
// LetterOfCredit / TaxRefund / TradeDocument / CustomsDeclarationLine）
// 服装外贸出口合规闭环：发货 → 报关 → 退税 → 外汇结算 → 信用证
// ══════════════════════════════════════════════════════════════════════════════

model CustomsDeclaration {
  id                String @id // 格式：CD_${shortId}
  declarationNumber String @unique // 报关单号（海关统一编号）

  // ─── 关联（snapshot FK，无 Prisma relation） ───
  shipmentId String? // 关联 Shipment
  orderId    String? // 关联 Order
  relationId String? // 关联 Relation（客户/供应商）

  // ─── 报关类型 ───
  type   String // Export(出口) | Import(进口)
  status String @default("Draft") // Draft | Submitted | Declared | Inspecting | Released | Exception | Cancelled

  // ─── 申报信息 ───
  declarationDate String? // 申报日期 YYYY-MM-DD
  customsCode     String? // 海关编码（申报地海关代码）
  declarationPort String? // 申报口岸
  tradeTerms      String? // 贸易条款 FOB | CIF | EXW | DDP | FCA | CPT | CIP | DAP | DPU

  // ─── 金额 ───
  totalValue Decimal? @db.Decimal(18, 4) // 申报总额
  currency   String? // 币种

  // ─── 包装/重量 ───
  totalPackages Int? // 总件数
  grossWeight   Decimal? @db.Decimal(18, 4) // 毛重(kg)
  netWeight     Decimal? @db.Decimal(18, 4) // 净重(kg)

  // ─── 贸易方 ───
  originCountry      String? // 原产国
  destinationCountry String? // 目的国
  consignee          String? // 收货人
  consignor          String? // 发货人
  declarant          String? // 报关员
  agent              String? // 报关行

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  lines CustomsDeclarationLine[]

  @@index([shipmentId])
  @@index([orderId])
  @@index([relationId])
  @@index([status])
  @@index([type])
}

model CustomsDeclarationLine {
  id            String @id // 格式：CDL_${shortId}
  declarationId String

  lineNumber Int

  // ─── 商品信息 ───
  productCode   String?
  productName   String
  hsCode        String? // HS 编码（关联 HsCode.code）
  brandName     String? // 品牌
  specification String? // 规格型号

  // ─── 数量/价格 ───
  quantity    Decimal  @db.Decimal(18, 4)
  unit        String
  unitPrice   Decimal? @db.Decimal(18, 4)
  totalAmount Decimal? @db.Decimal(18, 4)
  currency    String?

  // ─── 重量 ───
  grossWeight Decimal? @db.Decimal(18, 4)
  netWeight   Decimal? @db.Decimal(18, 4)

  // ─── 产地 ───
  originCountry String?

  notes     String?
  createdAt BigInt
  updatedAt BigInt

  declaration CustomsDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@index([declarationId])
  @@index([hsCode])
}

model HsCode {
  id   String @id // 格式：HS_${shortId}
  code String @unique // HS 编码（如 5208.52.00.00）

  description String // 商品描述
  category    String // Textile(纺织品) | Garment(服装) | Accessory(辅料) | Material(原料) | Yarn(纱线) | Other

  // ─── 税率 ───
  exportTaxRebateRate Decimal? @db.Decimal(6, 4) // 出口退税率(%)
  importTariffRate    Decimal? @db.Decimal(6, 4) // 进口关税率(%)
  vatRate             Decimal? @db.Decimal(6, 4) // 增值税率(%)

  // ─── 海关监管 ───
  unit                 String? // 法定计量单位
  supervisionCondition String? // 监管条件代码
  inspectionQuarantine String? // 检验检疫类别
  additionalDuty       String? // 附加关税说明

  notes    String?
  isActive Boolean @default(true)

  createdAt BigInt
  updatedAt BigInt

  @@index([code])
  @@index([category])
  @@index([isActive])
}

model LetterOfCredit {
  id       String @id // 格式：LC_${shortId}
  lcNumber String @unique // 信用证号

  // ─── 关联（snapshot FK） ───
  relationId String? // 关联客户
  orderId    String? // 关联订单

  // ─── 类型/状态 ───
  type   String // Irrevocable(不可撤销) | Revocable(可撤销) | Standby(备用) | Transferable(可转让)
  status String @default("Issued") // Issued | Presented | Accepted | Discrepant | Settled | Expired | Cancelled

  // ─── 银行 ───
  issueDate       String? // 开证日期
  issueBank       String? // 开证行
  advisingBank    String? // 通知行
  negotiatingBank String? // 议付行
  confirmingBank  String? // 保兑行

  // ─── 贸易方 ───
  applicant   String? // 申请人（进口方）
  beneficiary String? // 受益人（出口方）

  // ─── 金额 ───
  amount          Decimal  @db.Decimal(18, 4) // 信用证金额
  currency        String   @default("USD")
  availableAmount Decimal? @db.Decimal(18, 4) // 可用余额

  // ─── 期限 ───
  expiryDate           String? // 有效期
  expiryPlace          String? // 到期地
  presentationDeadline String? // 交单期限
  shipmentDeadline     String? // 最迟装运期

  // ─── 贸易条款 ───
  tradeTerms      String? // FOB | CIF | ...
  portOfLoading   String? // 装运港
  portOfDischarge String? // 卸货港

  // ─── 单据/条款 ───
  documentsRequired Json? // 要求单据列表（JSON array）
  specialConditions String? // 特殊条款
  discrepancies     String? // 不符点记录

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([relationId])
  @@index([orderId])
  @@index([status])
  @@index([lcNumber])
}

// LcEvent：信用证节点事件（F1 lifecycle 深化）
// 每次状态机转换在事务内追加一条节点事件，形成可回溯的
// 开证→交单→承兑/不符点→结清/过期/作废 业务时间轴（独立于通用 auditLog，
// 面向业务查询与前端时间轴渲染；append-only，无软删）。
model LcEvent {
  id   String @id // 格式：LCE__${shortId}
  lcId String // 关联信用证

  // ─── 节点信息 ───
  fromNode String? // 上一节点（首节点为 null）
  toNode   String // 到达节点（取值与信用证状态一致：Issued | Presented | Accepted | Discrepant | Settled | Expired | Cancelled）

  eventDate String // 节点业务日期 YYYY-MM-DD（默认当日，可按银行实际日期回填）
  note      String? // 节点备注（不符点内容 / 银行参考号等）
  actorId   String? // 操作人

  createdAt BigInt

  @@index([lcId])
  @@index([toNode])
}

model TaxRefund {
  id           String @id // 格式：TR_${shortId}
  refundNumber String @unique // 退税申报编号

  // ─── 关联（snapshot FK） ───
  declarationId String? // 关联报关单
  orderId       String? // 关联订单
  relationId    String? // 关联客户

  status String @default("Draft") // Draft | Submitted | Reviewing | Approved | Rejected | Refunded | Cancelled

  // ─── 出口信息 ───
  exportDate      String? // 出口日期
  declarationDate String? // 申报日期

  // ─── 金额计算 ───
  fxRate                  Decimal? @db.Decimal(18, 8) // 外汇汇率
  exportAmountFob         Decimal? @db.Decimal(18, 4) // 出口FOB金额（原币）
  exportAmountFobCurrency String? // 出口金额币种
  exportAmountCny         Decimal? @db.Decimal(18, 4) // 折人民币金额
  refundableVat           Decimal? @db.Decimal(18, 4) // 可退增值税额
  refundableRate          Decimal? @db.Decimal(6, 4) // 退税率(%)
  refundAmount            Decimal? @db.Decimal(18, 4) // 实际退税额
  refundDate              String? // 退税到账日期

  // ─── 审核 ───
  reviewedBy  String? // 审核人
  reviewedAt  BigInt? // 审核时间
  reviewNotes String? // 审核意见

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([declarationId])
  @@index([orderId])
  @@index([relationId])
  @@index([status])
}

model TradeDocument {
  id             String @id // 格式：TD_${shortId}
  documentNumber String @unique // 单据编号

  type   String // CommercialInvoice | PackingList | CertificateOfOrigin | BillOfLading | AirWaybill | InsuranceCert | InspectionCert | PhytosanitaryCert | Other
  status String @default("Draft") // Draft | Issued | Submitted | Accepted | Rejected | Cancelled

  // ─── 关联（snapshot FK） ───
  shipmentId    String? // 关联货运单
  declarationId String? // 关联报关单
  orderId       String? // 关联订单
  relationId    String? // 关联客户

  // ─── 单据信息 ───
  issueDate       String? // 签发日期
  expiryDate      String? // 有效期
  issuedBy        String? // 签发方
  consignee       String? // 收货人
  consignor       String? // 发货人
  portOfLoading   String?
  portOfDischarge String?

  // ─── 金额 ───
  totalAmount Decimal? @db.Decimal(18, 4) // 单据金额
  currency    String?

  // ─── 附件 ───
  filePath String? // 文件路径
  fileName String? // 文件名

  notes     String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([shipmentId])
  @@index([declarationId])
  @@index([orderId])
  @@index([relationId])
  @@index([type])
  @@index([status])
}

// ════════════════════════════════════════════════════════════════════
// A5 报表引擎 — ReportDefinition / ReportRun
// ════════════════════════════════════════════════════════════════════
// 设计决策：
//   - 数据集白名单在服务端注册表（reporting/datasets.ts），definition 只存
//     datasetKey + 维度/指标/过滤的字段名，执行时由引擎校验白名单（fail closed），
//     杜绝客户端注入任意 Prisma 查询。
//   - dimensions: string[]（字段名）；metrics: [{field, agg}]（agg ∈ sum|avg|min|max|count）；
//     filters: [{field, op, value}]（op ∈ eq|ne|in|gte|lte|contains）。
//   - 定时调度：schedule ∈ daily|weekly|monthly|null，幂等键 = definitionId:periodKey
//     （daily=YYYY-MM-DD / weekly=YYYY-Www / monthly=YYYY-MM），同一周期重复触发
//     靠 ReportRun.idempotencyKey unique 约束 fail closed。
//   - 结果快照直接存 ReportRun.rows（上限 5000 行），导出 CSV 重放快照而非重查，
//     保证导出内容与运行时刻一致（可审计）。
//   - 软删（deletedAt）；定义删除后历史运行记录保留。
// ════════════════════════════════════════════════════════════════════
model ReportDefinition {
  id          String  @id // 格式：RPD__${shortId}
  name        String
  description String?

  // ─── 查询定义（白名单字段名，执行时由引擎校验） ───
  datasetKey String // orders|invoices|paymentVouchers|shipments|vatInvoices|outwardRemittances|taxRefunds
  dimensions Json    // string[]
  metrics    Json    // Array<{ field: string; agg: 'sum'|'avg'|'min'|'max'|'count' }>
  filters    Json?   // Array<{ field: string; op: 'eq'|'ne'|'in'|'gte'|'lte'|'contains'; value: unknown }>

  // ─── 定时调度 ───
  schedule String? // daily | weekly | monthly | null（null=仅手动）
  enabled  Boolean @default(true)
  lastRunAt BigInt?

  createdBy String?
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?

  @@index([datasetKey])
  @@index([enabled])
}

model ReportRun {
  id             String  @id // 格式：RPR__${shortId}
  definitionId   String // 关联定义（snapshot FK，定义可软删）
  definitionName String // 冗余快照：定义改名后历史运行仍可读

  status  String // Running | Success | Failed
  trigger String // manual | schedule

  // ─── 调度幂等键（definitionId:periodKey），手动运行为 null ───
  idempotencyKey String? @unique

  // ─── 结果快照 ───
  rowCount     Int?
  columns      Json? // string[]（列键）
  columnLabels Json? // string[]（展示表头，与 columns 同序，导出 CSV 直接用）
  rows         Json? // Array<Record<string, unknown>>（上限 5000 行快照）
  error        String?

  startedAt  BigInt
  finishedAt BigInt?
  createdAt  BigInt

  @@index([definitionId])
  @@index([status])
  @@index([createdAt])
}
