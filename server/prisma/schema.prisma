  currency    String  @default("CNY")

  // ─── 状态 ───
  status String @default("Pending") // Pending | Confirmed | Paid

  // ─── 其他 ───
  notes     String?
  createdAt BigInt
  updatedAt BigInt

  pieceRateRule PieceRateRule @relation(fields: [pieceRateRuleId], references: [id])

  @@index([pieceRateRuleId])
  @@index([productionPlanId])
  @@index([employeeId])
  @@index([workDate])
  @@index([status])
