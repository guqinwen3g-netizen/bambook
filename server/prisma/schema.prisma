model ProductClassification {
  id           String  @id
  mainCategory String
  dimension    String
  name         String
  description  String?
  sortOrder    Int?
  updatedAt    BigInt
  deletedAt    BigInt?

  links ProductClassificationLink[]

  @@index([mainCategory])
  @@index([dimension])
}

model ProductClassificationLink {
  id               String  @id
  productAssetId   String
  classificationId String
  updatedAt        BigInt
  deletedAt        BigInt?

  productAsset   ProductAsset          @relation(fields: [productAssetId], references: [id], onDelete: Cascade)
