  deletedAt              BigInt?

  productAsset ProductAsset @relation(fields: [productAssetId], references: [id], onDelete: Cascade)

  @@index([productAssetId])
  @@index([priceType])
  @@index([customerOrganizationId])
  @@index([sourceType, sourceId])
