# Copy this file to `.env` and replace placeholders. Never commit `.env`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/panda_hub?schema=public"
PORT=8081

# Required for public Mac mini deployment.
BAMBOOK_REQUIRE_AUTH=true
BAMBOOK_SDK_KEY="replace-with-a-long-random-token"

# Legacy local SQLite source used only for migration/rollback verification.
PO_DATABASE_PATH="/Users/qinwengu/WorkBuddy/Claw/database/po_database.db"

# Backup script defaults.
BAMBOOK_BACKUP_DIR="/Users/Shared/BambookBackups"

# ─── Melo TTS（默认 provider，部署到 Mac Mini 时必填）───────────────────
# Provider 切换：当前仅支持 melo
BAMBOOK_TTS_PROVIDER=melo

# 主 API 调 Melo 服务的 HTTP 入口（必填，否则 getMeloServiceUrl() 直接 throw）
BAMBOOK_MELO_URL=http://127.0.0.1:8765
BAMBOOK_MELO_HOST=127.0.0.1
BAMBOOK_MELO_PORT=8765

# Melo 服务自身依赖的 Python（必须是持久路径，禁止 /tmp/*）
# 由 ops-setup-melo-tts.sh / ops-panel "安装 Melo" 自动生成
BAMBOOK_MELO_PYTHON=/Users/panda1/bambook-main-api/.venv-melo/bin/python

# 主 API → Melo 单次合成的 fetch 超时（毫秒）
BAMBOOK_MELO_REQUEST_TIMEOUT_MS=120000

# 默认合成参数（前端 voiceSpeed 通过 rate 百分比叠加在 baseline 上）
BAMBOOK_MELO_DEFAULT_SPEED=1.0
BAMBOOK_MELO_DEFAULT_LANGUAGE=ZH

# Melo 推理参数（对应 MeloTTS.tts_to_file 的 sdp_ratio / noise_scale / noise_scale_w）
# 改完 ops-panel restartMainApi 即可生效，无需改代码或重新部署
BAMBOOK_MELO_SDP_RATIO=0.2
BAMBOOK_MELO_NOISE_SCALE=0.6
BAMBOOK_MELO_NOISE_SCALE_W=0.8

# 主 API 启动后是否自动预热 Melo（首句延迟约 -3s）
BAMBOOK_MELO_PREWARM_ON_START=true

# 单次 TTS 文本上限（字符）
BAMBOOK_TTS_MAX_CHARS=2000

# HuggingFace 镜像（首次下载模型用，下载完后建议设 HF_HUB_OFFLINE=1）
BAMBOOK_HF_ENDPOINT=https://hf-mirror.com

# ─── Agent API Key Service Principal ───────────────────────────
# API Key 认证的 Agent 调用需要绑定一个最小权限服务主体（service principal）。
# 不配置时，API Key 认证的 Agent 调用将被拒绝（AI Runtime 返回 UNAUTHORIZED）。
# actor_id 必须对应 UserAccount 表中存在的用户 ID。
# roles 为逗号分隔的 AgentRole 值（owner/admin/manager/merchandiser/finance/sales/
#   logistics/production_manager/factory/viewer/agent_operator）。
# 注意：带空格的值必须加引号（bash source 兼容，否则会导致启动脚本退出码 127）。
# 必填（生产环境）：
BAMBOOK_AGENT_API_KEY_ACTOR_ID="replace-with-user-id-from-UserAccount"
BAMBOOK_AGENT_API_KEY_ROLES="agent_operator"
# 可选：
BAMBOOK_AGENT_API_KEY_DISPLAY_NAME="Bambook API Service"
BAMBOOK_AGENT_API_KEY_DEPARTMENTS="company"
