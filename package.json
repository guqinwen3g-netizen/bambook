{
  "name": "bambook-intelligent-hub",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev:stack": "bash scripts/dev-stack.sh",
    "dev:agent-local": "bash scripts/agent-local-stack.sh web",
    "dev": "vite",
    "dev:desktop": "VITE_UI_MODE=desktop vite --port 3000",
    "dev:panda-lab": "BAMBOOK_UI_LAB_DEV=1 vite --host 0.0.0.0 --port 3105 --open /dev-panda-lab.html",
    "build": "vite build",
    "build:desktop": "VITE_UI_MODE=desktop vite build",
    "audit:os-vnext": "node scripts/audit-os-vnext.mjs",
    "preview": "vite preview",
    "electron:dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "electron:agent-local": "bash scripts/agent-local-stack.sh electron",
    "electron:build": "electron-vite build",
    "electron:preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "electron:start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:rebuild:native": "node node_modules/@electron/rebuild/lib/cli.js -f --only better-sqlite3",
    "notify": "./scripts/bark_notify.sh",
    "restart:dev": "./scripts/restart_dev.sh",
    "reload": "bash scripts/reload-electron.sh",
    "agent:status": "node scripts/agent-runtime-status.mjs",
    "deploy:web": "bash scripts/ops-upload-webapp.sh",
    "deploy:server": "bash scripts/ops-upload-package.sh",
    "deploy:all": "npm run deploy:server && npm run deploy:web",
    "check:tokens": "bash scripts/check-design-tokens.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.18",
    "@fontsource/urbanist": "^5.2.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.182.0",
    "ai": "^6.0.49",
    "axios": "^1.13.3",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.29.0",
    "harmonyos-sans-sc-webfont-splitted": "^1.1.0",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.24.0",
    "mermaid": "^11.15.0",
    "openai": "^6.16.0",
    "pdf-parse": "^2.4.5",
    "pmtiles": "^4.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx": "^1.13.2",
    "three": "^0.182.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jimp": "^1.6.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.bambook.desktop",
    "productName": "Bambook",
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      {
        "from": "models/stt/paraformer-zh-en-int8",
        "to": "models/stt/paraformer-zh-en-int8"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sherpa-onnx/**/*"
    ]
  }
}
